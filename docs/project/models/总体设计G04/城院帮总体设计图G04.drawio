etry" /></mxCell><mxCell id="8" value="运维会话、恢复动作、固定目标及&#10;备份引用" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=0;verticalAlign=middle;align=left;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=0;fontColor=#203a4b;fillColor=#edf4f6;strokeColor=#c5d3da;spacingLeft=14" vertex="1" parent="1"><mxGeometry x="50" y="243" width="408" height="124" as="geometry" /></mxCell><mxCell id="9" value="M7.1 授权与确认&#10;核对运维授权和受控备份，绑定恢复范围&#10;并签发短期确认" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=0;verticalAlign=middle;align=left;fontFamily=Microsoft YaHei;fontSize=23;fontStyle=0;fontColor=#203a4b;fillColor=#e2f1ee;strokeColor=#96b8b0;spacingLeft=14" vertex="1" parent="1"><mxGeometry x="507" y="243" width="447" height="124" as="geometry" /></mxCell><mxCell id="10" value="恢复确认标识和有效期，或不可用／不&#10;兼容提示" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=0;verticalAlign=middle;align=left;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=0;fontColor=#203a4b;fillColor=#f1f7f9;strokeColor=#c5d3da;spacingLeft=14" vertex="1" parent="1"><mxGeometry x="1003" y="243" width="447" height="124" as="geometry" /></mxCell><mxCell id="11" value="" style="endArrow=block;endFill=1;strokeColor=#125e59;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="465" y="305" as="sourcePoint" /><mxPoint x="500" y="305" as="targetPoint" /></mxGeometry></mxCell><mxCell id="12" value="" style="endArrow=block;endFill=1;strokeColor=#125e59;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="961" y="305" as="sourcePoint" /><mxPoint x="996" y="305" as="targetPoint" /></mxGeometry></mxCell><mxCell id="13" value="" style="endArrow=block;endFill=1;strokeColor=#125e59;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="369" as="sourcePoint" /><mxPoint x="730" y="390" as="targetPoint" /></mxGeometry></mxCell><mxCell id="14" value="确认标识、原操作快照和请求键" style="rounded=1;a