 as="geometry"><mxPoint x="730" y="369" as="sourcePoint" /><mxPoint x="730" y="390" as="targetPoint" /></mxGeometry></mxCell><mxCell id="14" value="规范列表查询或文章标识。D2 的文&#10;章、公开版本和分类" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=0;verticalAlign=middle;align=left;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=0;fontColor=#203a4b;fillColor=#edf4f6;strokeColor=#c5d3da;spacingLeft=14" vertex="1" parent="1"><mxGeometry x="50" y="393" width="408" height="124" as="geometry" /></mxCell><mxCell id="15" value="M2.2 公开查询&#10;按公开状态查询。列表执行筛选、排序和&#10;分页，详情定位公开版本" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=0;verticalAlign=middle;align=left;fontFamily=Microsoft YaHei;fontSize=23;fontStyle=0;fontColor=#203a4b;fillColor=#e2f1ee;strokeColor=#96b8b0;spacingLeft=14" vertex="1" parent="1"><mxGeometry x="507" y="393" width="447" height="124" as="geometry" /></mxCell><mxCell id="16" value="列表页记录（可为空）或公开版本记录&#10;。不可见时返回不可用" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=0;verticalAlign=middle;align=left;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=0;fontColor=#203a4b;fillColor=#f1f7f9;strokeColor=#c5d3da;spacingLeft=14" vertex="1" parent="1"><mxGeometry x="1003" y="393" width="447" height="124" as="geometry" /></mxCell><mxCell id="17" value="" style="endArrow=block;endFill=1;strokeColor=#125e59;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="465" y="455" as="sourcePoint" /><mxPoint x="500" y="455" as="targetPoint" /></mxGeometry></mxCell><mxCell id="18" value="" style="endArrow=block;endFill=1;strokeColor=#125e59;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="961" y="455" as="sourcePoint" /><mxPoint x="996" y="455" as="targetPoint" /></mxGeometry></mxCell><mxCell id="19" value="" style="endArrow=block;endFill=1;strokeColor=#125e59;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="519" as="sourcePoint" /><mxPoint x="730" y="540" as="targetPoint" /></mxGeometry></mxCell><mxCell id="20" value="列表页记录或公开版本记录。场景&#10;字段白名单" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=0;verticalAlign=middle;align=left;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=0;fontColor=#203a4b;fillColor=#edf4f6;strokeColor=#c5d3da;spacingLeft=14" vertex="1" parent="1"><mxGeometry x="50" y="543" width="408" height="124" as="geometry" /></mxCell><mxCell id="21" value="M2.3 公开结果组装&#10;列表组装摘要和分页。详情组装正文、来&#10;源和可用公开媒体" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=0;verticalAlign=middle;align=left;fontFamily=Microsoft YaHei;fontSize=23;fontStyle=0;fontColor=#203a4b;fillColor=#e2f1ee;strokeColor=#96b8b0;spacingLeft=14" vertex="1" parent="1"><mxGeometry x="507" y="543" width="447" height="124" as="geometry" /></mxCell><mxCell id="22" value="列表项与分页元数据，或全文与公开媒&#10;体链接" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=0;verticalAlign=middle;align=left;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=0;fontColor=#203a4b;fillColor=#f1f7f9;strokeColor=#c5d3da;spacingLeft=14" vertex="1" parent="1"><mxGeometry x="1003" y="543" width="447" height="124" as="geometry" /></mxCell><mxCell id="23" value="" style="endArrow=block;endFill=1;strokeColor=#125e59;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="465" y="605" as="sourcePoint" /><mxPoint x="500" y="605" as="targetPoint" /></mxGeometry></mxCell><mxCell id="24" value="" style="endArrow=block;endFill=1;strokeColor=#125e59;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="961" y="605" as="sourcePoint" /><mxPoint x="996" y="605" as="targetPoint" /></mxGeometry></mxCell><mxCell id="25" value="M2.1 的规范输入给 M2.2。列表页和公开版本分别进入 M2.3 的对应输出分支。" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=0;verticalAlign=middle;align=left;fontFamily=Microsoft YaHei;fontSize=21;fontStyle=0;fontColor=#506576;fillColor=none;strokeColo