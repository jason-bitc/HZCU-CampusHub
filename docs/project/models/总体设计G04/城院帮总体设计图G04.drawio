23;fontStyle=0;fontColor=#203a4b;fillColor=#e2f1ee;strokeColor=#96b8b0;spacingLeft=14" vertex="1" parent="1"><mxGeometry x="507" y="393" width="447" height="124" as="geometry" /></mxCell><mxCell id="16" value="可发布内容与媒体引用。缺项或资源错&#10;误保留草稿及原公开版" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=0;verticalAlign=middle;align=left;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=0;fontColor=#203a4b;fillColor=#f1f7f9;strokeColor=#c5d3da;spacingLeft=14" vertex="1" parent="1"><mxGeometry x="1003" y="393" width="447" height="124" as="geometry" /></mxCell><mxCell id="17" value="" style="endArrow=block;endFill=1;strokeColor=#125e59;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="465" y="455" as="sourcePoint" /><mxPoint x="500" y="455" as="targetPoint" /></mxGeometry></mxCell><mxCell id="18" value="" style="endArrow=block;endFill=1;strokeColor=#125e59;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="961" y="455" as="sourcePoint" /><mxPoint x="996" y="455" as="targetPoint" /></mxGeometry></mxCell><mxCell id="19" value="" style="endArrow=block;endFill=1;strokeColor=#125e59;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="519" as="sourcePoint" /><mxPoint x="730" y="540" as="targetPoint" /></mxGeometry></mxCell><mxCell id="20" value="可发布内容、媒体引用、文章与请&#10;求键" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=0;verticalAlign=middle;align=left;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=0;fontColor=#203a4b;fillColor=#edf4f6;strokeColor=#c5d3da;spacingLeft=14" vertex="1" parent="1"><mxGeometry x="50" y="543" width="408" height="124" as="geometry" /></mxCell><mxCell id="21" value="M3.2.3 提交公开版本&#10;同一事务写入新版本、公开指针、请求回&#10;执及审计" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=0;verticalAlign=middle;align=left;fontFamily=Microsoft YaHei;fontSize=23;fontStyle=0;fontColor=#203a4b;fillColor=#e2f1ee;strokeColor=#96b8b0;spacingLeft=14" vertex="1" parent="1"><mxGeometry x="507" y="543" width="447" height="124" as="geometry" /></mxCell><mxCell id="22" value="新版本号、修订和发布回执。提交失败&#10;保持原公开状态" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=0;verticalAlign=middle;align=left;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=0;fontColor=#203a4b;fillColor=#f1f7f9;strokeColor=#c5d3da;spacingLeft=14" vertex="1" parent="1"><mxGeometry x="1003" y="543" width="447" height="124" as="geometry" /></mxCell><mxCell id="23" value="" style="endArrow=block;endFill=1;strokeColor=#125e59;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="465" y="605" as="sourcePoint" /><mxPoint x="500" y="605" as="targetPoint" /></mxGeometry></mxCell><mxCell id="24" value="" style="endArrow=block;endFill=1;strokeColor=#125e59;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="961" y="605" as="sourcePoint" /><mxPoint x="996" y="605" as="targetPoint" /></mxGeometry></mxCell><mxCell id="25" value="原回执或校验失败结束当前请求。新发布只有在事务提交成功后，才对公开阅读可见。" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=0;verticalAlign=middle;align=left;fontFamily=Microsoft YaHei;fontSize=21;fontStyle=0;fontColor=#506576;fillColor=none;strokeColor=none;spacingLeft=0" vertex="1" parent="1"><mxGeometry x="50" y="698" width="1400" height="55" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="HLD23" name="HLD23 文章投币 IPO"><mxGraphModel page="1" pageScale="1" grid="1" gridSize="10" pageWidth="1500" pageHeight="765"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="HLD23  文章投币 IPO" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=0;verticalAlign=middle;align=left;fontFamily=Microsoft YaHei;fontSize=43;fontStyle=1;fontColor=#203a4b;fillColor=none;strokeColor=none;spacingLeft=0" vertex="1" parent="1"><mxGeometry x="48" y="32" width="1400" height="58" as="geometry" /></mxCell><mxCell id="3" value="M5.2 文章投币  ·  P3.1、P3.3–P3.4 · FR-G03、FR-G04 · §5.2.2 重复投币" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=0;verticalAlign=middle;align=left;fontFamily=Microsoft YaHei;fontSize=23;fontStyle=0;fontColor=#506576;fillColor=none;strokeColor=none;spacingLeft=0" vertex="1" parent="1"><mxGeometry x="48" y="98" width="1400" height="38" as="geometry" /></mxCell><mxCell id="4" value="" style="endArrow=none;endFill=1;strokeColor=#a7bac4;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="50" y="151" as="sourcePoint" /><mxPoint x="1450" y="151" as="targetPoint" /></mxGeometry></mxCell><mxCell id="5" value="输入 I" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=0;verticalAlign=middle;align=left;fontFamily=Microsoft YaHei;fontSize=26;fontStyle=1;fontColor=#125e59;fillColor=#e4f1ee;strokeColor=#c5d3da;spacingLeft=14" vertex="1" parent="1"><mxGeometry x="50" y="177" width="408" height="52" as="geometry" /></mxCell><mxCell id="6" value="处理 P" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=0;verticalAlign=middle;align=left;fontFamily=Microsoft YaHei;fontSize=26;fontStyle=1;fontColor=#125e59;fillColor=#e4f1ee;strokeColor=#c5d3da;spacingLeft=14" vertex="1" parent="1"><mxGeometry x="507" y="177" width="447" height="52" as="geometry" /></mxCell><mxCell id="7" value="输出 O" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=0;verticalAlign=middle;align=left;fontFamily=Microsoft YaHei;fontSize=26;fontStyle=1;fontColor=#125e59;fillColor=#e4f1ee;strokeColor=#c5d3da;spacingLeft=14" vertex="1" parent="1"><mxGeometry x="1003" y="177" width="447" height="52" as="geometry" /></mxCell><mxCell id="8" value="认证主体、文章 ID、投币数和请求&#10;键" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=0;verticalAlign=middle;align=left;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=0;fontColor=#203a4b;fillColor=#edf4f6;strokeColor=#c5d3da;spacingLeft=14" vertex="1" parent="1"><mxGeometry x="50" y="243" width="408" height="124" as="geometry" /></mxCell><mxCell id="9" value="M5.2.1 核对请求与回执&#10;查已提交回执，核对同键请求语义" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=0;verticalAlign=middle;align=left;fontFamily=Microsoft YaHei;fontSize=23;fontStyle=0;fontColor=#203a4b;fillColor=#e2f1ee;strokeColor=#96b8b0;spacingLeft=14" vertex="1" parent="1"><mxGeometry x="507" y="243" width="447" height="124" as="geometry" /></mxCell><mxCell id="10" value="可继续请求，或原回执、请求键冲突" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=0;verticalAlign=middle;align=left;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=0;fontColor=#203a4b;fillColor=#f1f7f9;strokeColor=#c5d3da;spacingLeft=14" vertex="1" parent="1"><mxGeometry x="1003" y="243" width="447" height="124" as="geometry" /></mxCell><mxCell id="11" value="" style="endArrow=block;endFill=1;strokeColor=#125e59;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="465" y="305" as="sourcePoint" /><mxPoint x="500" y="305" as="targetPoint" /></mxGeometry></mxCell><mxCell id="12" value="" style="endArrow=block;endFill=1;strokeColor=#125e59;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="961" y="305" as="sourcePoint" /><mxPoint x="996" y="305" as="targetPoint" /></mxGeometry></mxCell><mxCell id="13" value="" style="endArrow=block;endFill=1;strokeColor=#125e59;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="369" as="sourcePoint" /><mxPoint x="730" y="390" as="targetPoint" /></mxGeometry></mxCell><mxCell id="14" value="可继续请求、公开文章、作者、钱&#10;包余额、累计投币数" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=0;verticalAlign=middle;align=left;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=0;fontColor=#203a4b;fillColor=#edf4f6;strokeColor=#c5d3da;spacingLeft=14" vertex="1" parent="1"><mxGeometry x="50" y="393" width="408" height="124" as="geometry" /></mxCell><mxCell id="15" value="M5.2.2 核对文章和钱包&#10;按文章再钱包顺序加锁并复查回执。目标&#10;不可见时补查回执。核对作者、额度和余&#10;额" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=0;verticalAlign=middle;align=left;fontFamily=Microsoft YaHei;fontSize=23;fontStyle=0;fontColor=#203a4b;fillColor=#e2f1ee;strokeColor=#96b8b0;spacingLeft=14" vertex="1" parent="1"><mxGeometry x="507" y="393" width="447" height="124" as="geometry" /></mxCell><mxCell id="16" value="可执行扣币指令，或原回执、不可见、&#10;额度或余额拒绝" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=0;verticalAlign=middle;align=left;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=0;fontColor=#203a4b;fillColor=#f1f7f9;strokeColor=#c5d3da;spacingLeft=14" vertex="1" parent="1"><mxGeometry x="1003" y="393" width="447" height="124" as="geometry" /></mxCell><mxCell id="17" value="" style="endArrow=block;endFill=1;strokeColor=#125e59;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="465" y="455" as="sourcePoint" /><mxPoint x="500" y="455" as="targetPoint" /></mxGeometry></mxCell><mxCell id="18" value="" style="endArrow=block;endFill=1;strokeColor=#125e59;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="961" y="455" as="sourcePoint" /><mxPoint x="996" y="455" as="targetPoint" /></mxGeometry></mxCell><mxCell id="19" value="" style="endArrow=block;endFill=1;strokeColor=#125e59;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="519" as="sourcePoint" /><mxPoint x="730" y="540" as="targetPoint" /></mxGeometry></mxCell><mxCell id="20" value="扣币指令、锁定钱包和上一笔状态" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=0;verticalAlign=middle;align=left;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=0;fontColor=#203a4b;fillColor=#edf4f6;strokeColor=#c5d3da;spacingLeft=14" vertex="1" parent="1"><mxGeometry x="50" y="543" width="408" height="124" as="geometry" /></mxCell><mxCell id="21" value="M5.2.3 记账与回执&#10;同一事务更新余额并追加账本事件与审计" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=0;verticalAlign=middle;align=left;fontFamily=Microsoft YaHei;fontSize=23;fontStyle=0;fontColor=#203a4b;fillColor=#e2f1ee;strokeColor=#96b8b0;spacingLeft=14" vertex="1" parent="1"><mxGeometry x="507" y="543" width="447" height="124" as="geometry" /></mxCell><mxCell id="22" value="投币回执及新余额。失败回滚，本次无&#10;新增扣币" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=0;verticalAlign=middle;align=left;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=0;fontColor=#203a4b;fillColor=#f1f7f9;strokeColor=#c5d3da;spacingLeft=14" vertex="1" parent="1"><mxGeometry x="1003" y="543" width="447" height="124" as="geometry" /></mxCell><mxCell id="23" value="" style="endArrow=block;endFill=1;strokeColor=#125e59;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="465" y="605" as="sourcePoint" /><mxPoint x="500" y="605" as="targetPoint" /></mxGeometry></mxCell><mxCell id="24" value="" style="endArrow=block;endFill=1;strokeColor=#125e59;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="961" y="605" as="sourcePoint" /><mxPoint x="996" y="605" as="targetPoint" /></mxGeometry></mxCell><mxCell id="25" value="同键同语义成功后可重放。重复请求、额度不足和事务失败均可从回执或账本核查。" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=0;verticalAlign=middle;align=left;fontFamily=Microsoft YaHei;fontSize=21;fontStyle=0;fontColor=#506576;fillColor=none;strokeColor=none;spacingLeft=0" vertex="1" parent="1"><mxGeometry x="50" y="698" width="1400" height="55" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="HLD24" name="HLD24 举报受理与处置 IPO"><mxGraphModel page="1" pageScale="1" grid="1" gridSize="10" pageWidth="1500" pageHeight="900"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="HLD24  举报受理与处置 IPO" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=0;verticalAlign=middle;align=left;fontFamily=Microsoft YaHei;fontSize=43;fontStyle=1;fontColor=#203