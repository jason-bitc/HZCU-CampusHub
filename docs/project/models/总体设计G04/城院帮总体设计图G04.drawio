;align=left;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=0;fontColor=#203a4b;fillColor=#edf4f6;strokeColor=#c5d3da;spacingLeft=14" vertex="1" parent="1"><mxGeometry x="50" y="543" width="408" height="124" as="geometry" /></mxCell><mxCell id="21" value="M7.2.2 执行、核验与回退&#10;执行前复核，保留保护副本，恢复数据库&#10;和媒体等内容，核验健康。执行失败尝试&#10;保护回退" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=0;verticalAlign=middle;align=left;fontFamily=Microsoft YaHei;fontSize=23;fontStyle=0;fontColor=#203a4b;fillColor=#e2f1ee;strokeColor=#96b8b0;spacingLeft=14" vertex="1" parent="1"><mxGeometry x="507" y="543" width="447" height="124" as="geometry" /></mxCell><mxCell id="22" value="阶段事件和核验结果。回退失败进入人&#10;工恢复" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=0;verticalAlign=middle;align=left;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=0;fontColor=#203a4b;fillColor=#f1f7f9;strokeColor=#c5d3da;spacingLeft=14" vertex="1" parent="1"><mxGeometry x="1003" y="543" width="447" height="124" as="geometry" /></mxCell><mxCell id="23" value="" style="endArrow=block;endFill=1;strokeColor=#125e59;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="465" y="605" as="sourcePoint" /><mxPoint x="500" y="605" as="targetPoint" /></mxGeometry></mxCell><mxCell id="24" value="" style="endArrow=block;endFill=1;strokeColor=#125e59;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="961" y="605" as="sourcePoint" /><mxPoint x="996" y="605" as="targetPoint" /></mxGeometry></mxCell><mxCell id="25" value="" style="endArrow=block;endFill=1;strokeColor=#125e59;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="669" as="sourcePoint" /><mxPoint x="730" y="690" as="targetPoint" /></mxGeometry></mxCell><mxCell id="26" value="运维会话、任务 ID、持久任务和阶&#10;段事件" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=0;verticalAlign=middle;align=left;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=0;fontColor=#203a4b;fillColor=#edf4f6;strokeColor=#c5d3da;spacingLeft=14" vertex="1" parent="1"><mxGeometry x="50" y="693" width="408" height="124" as="geometry" /></mxCell><mxCell id="27" value="M7.3 查询阶段及终态&#10;受理后即可从独立入口查询。读取并脱敏&#10;任务和阶段事件，区分受理、执行与终态" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=0;verticalAlign=middle;align=left;fontFamily=Microsoft YaHei;fontSize=23;fontStyle=0;fontColor=#203a4b;fillColor=#e2f1ee;strokeColor=#96b8b0;spacingLeft=14" vertex="1" parent="1"><mxGeometry x="507" y="693" width="447" height="124" as="geometry" /></mxCell><mxCell id="28" value="阶段、失败原因、回退结果或已核验的&#10;恢复结果" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=0;verticalAlign=middle;align=left;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=0;fontColor=#203a4b;fillColor=#f1f7f9;strokeColor=#c5d3da;spacingLeft=14" vertex="1" parent="1"><mxGeometry x="1003" y="693" width="447" height="124" as="geometry" /></mxCell><mxCell id="29" value="" style="endArrow=block;endFill=1;strokeColor=#125e59;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="465" y="755" as="sourcePoint" /><mxPoint x="500" y="755" as="targetPoint" /></mxGeometry></mxCell><mxCell id="30" value="" style="endArrow=block;endFill=1;strokeColor=#125e59;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="961" y="755" as="sourcePoint" /><mxPoint x="996" y="755" as="targetPoint" /></mxGeometry></mxCell><mxCell id="31" value="M7.1 的确认标识用于提交。任务 ID 可立即查询，恢复结果随后通过阶段事件返回，业务停机时仍可查询。" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=0;verticalAlign=middle;align=left;fontFamily=Microsoft YaHei;fontSize=21;fontStyle=0;fontColor=#506576;fillColor=none;strokeColor=none;spacingLeft=0" vertex="1" parent="1"><mxGeometry x="50" y="833" width="1400" height="55" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>