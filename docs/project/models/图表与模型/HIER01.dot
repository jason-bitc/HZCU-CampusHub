digraph G {
graph [rankdir=TB,nodesep=0.45,ranksep=0.65,bgcolor="white",splines=polyline,pad=0.35];
node [fontname="Microsoft YaHei",fontsize=14,color="#223846",penwidth=1.2,margin="0.12,0.10",fillcolor="white",style="filled"];
edge [fontname="Microsoft YaHei",fontsize=11,color="#526775",arrowsize=0.7];
"root" [shape=box,label="经验文章数据包",width=1.667,height=0.556,style="rounded,filled"];
"base" [shape=box,label="标识与经历背景",width=1.667,height=0.556,style="rounded,filled"];
"body" [shape=box,label="正文版本",width=1.083,height=0.556,style="rounded,filled"];
"public" [shape=box,label="公开与互动摘要",width=1.667,height=0.556,style="rounded,filled"];
"id" [shape=box,label="文章标识 作者 岗位\n可选公司 专业 经历阶段",width=2.364,height=0.861,style="rounded,filled"];
"seq" [shape=box,label="有序内容块\n文字 图片引用 来源链接",width=2.364,height=0.861,style="rounded,filled"];
"vs" [shape=box,label="草稿版本 公开版本指针",width=2.307,height=0.556,style="rounded,filled"];
"state" [shape=box,label="可见状态 时间",width=1.529,height=0.556,style="rounded,filled"];
"counts" [shape=box,label="认可 收藏 获币汇总",width=1.975,height=0.556,style="rounded,filled"];
"root" -> "base" [dir=none];
"root" -> "body" [dir=none];
"root" -> "public" [dir=none];
"base" -> "id" [dir=none];
"body" -> "seq" [dir=none];
"body" -> "vs" [dir=none];
"public" -> "state" [dir=none];
"public" -> "counts" [dir=none];
}