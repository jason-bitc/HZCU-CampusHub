"P2.3" -> "E1" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="2" WIDTH="46"><TR><TD><FONT FACE="Microsoft YaHei" POINT-SIZE="11">F02.2</FONT></TD></TR></TABLE>>];
"P2.1" -> "D1" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="2" WIDTH="34"><TR><TD><FONT FACE="Microsoft YaHei" POINT-SIZE="11">I03</FONT></TD></TR></TABLE>>];
"D1" -> "P2.1" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="2" WIDTH="34"><TR><TD><FONT FACE="Microsoft YaHei" POINT-SIZE="11">I04</FONT></TD></TR></TABLE>>];
"P2.3" -> "D2" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="2" WIDTH="34"><TR><TD><FONT FACE="Microsoft YaHei" POINT-SIZE="11">I05</FONT></TD></TR></TABLE>>];
