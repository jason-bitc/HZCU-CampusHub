digraph G {
graph [rankdir=LR,bgcolor="white",pad=0.3];
node [fontname="Microsoft YaHei",fontsize=14,shape=box];
edge [fontname="Microsoft YaHei",fontsize=11];
start [shape=point];
start -> O;
"O" [label="待处理 OPEN",shape=box];
"P" [label="处理中 PROCESSING",shape=box];
"N" [label="待进一步治理 NEEDS_ACTION",shape=box];
"C" [label="已关闭 CLOSED",shape=doublecircle];
"O" -> "P" [label="T01"];
"P" -> "O" [label="T02"];
"P" -> "C" [label="T03"];
"P" -> "N" [label="T04"];
"N" -> "O" [label="T05"];
"N" -> "C" [label="T06"];
"N" -> "N" [label="T07"];
"P" -> "P" [label="T08"];
}
