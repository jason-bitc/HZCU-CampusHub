"HonorAward" -> "HonorAward_a1" [label="",dir=none];
"Account" -> "rel21" [label="1",dir=none];
"rel21" -> "HonorAward" [label="0..N",dir=none];
"HonorRule" -> "rel22" [label="1",dir=none];
"rel22" -> "HonorAward" [label="0..N",dir=none];
}