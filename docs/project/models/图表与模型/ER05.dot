"HonorAward_a1" [shape=ellipse,label="规则标识",style="filled",fillcolor="white"];
"rel21" [shape=diamond,label="获得荣誉",style="filled",fillcolor="white"];
"rel22" [shape=diamond,label="评定依据",style="filled",fillcolor="white"];
"Account" -> "Account_a0" [label="",dir=none];
"Account" -> "Account_a1" [label="",dir=none];
