digraph G {
graph [rankdir=LR,nodesep=0.30,ranksep=0.48,bgcolor="white",splines=polyline,pad=0.20];
node [fontname="Microsoft YaHei",fontsize=13,color="#223846",penwidth=1.25,margin="0.10,0.07",style="rounded,filled",fillcolor="#F6F8FA"];
edge [fontname="Microsoft YaHei",fontsize=10,color="#526775",arrowsize=0.7];
"Account" [shape=box,label="账号",style="filled",fillcolor="white"];
"Wallet" [shape=box,label="可用币账户",style="filled",fillcolor="white"];
"CoinEntry" [shape=box,label="币账本事件",style="filled",fillcolor="white"];
"Contribution" [shape=box,label="作者贡献",style="filled",fillcolor="white"];
"Account_a0" [shape=ellipse,label=<<U>ID 主标识</U>>,style="filled",fillcolor="white"];
"Account_a1" [shape=ellipse,label="校园邮箱",style="filled",fillcolor="white"];
"Wallet_a0" [shape=ellipse,label=<<U>账号ID 主标识</U>>,style="filled",fillcolor="white"];
"Wallet_a1" [shape=ellipse,label="余额",style="filled",fillcolor="white"];
"CoinEntry_a0" [shape=ellipse,label=<<U>事件ID 主标识</U>>,style="filled",fillcolor="white"];
"CoinEntry_a1" [shape=ellipse,label="账号标识",style="filled",fillcolor="white"];
"Contribution_a0" [shape=ellipse,label=<<U>投币事件 主标识</U>>,style="filled",fillcolor="white"];
"Contribution_a1" [shape=ellipse,label="受益作者",style="filled",fillcolor="white"];
"rel12" [shape=diamond,label="持有",style="filled",fillcolor="white"];
"rel13" [shape=diamond,label="记账",style="filled",fillcolor="white"];
"rel14" [shape=diamond,label="投币贡献",style="filled",fillcolor="white"];
"rel15" [shape=diamond,label="获得",style="filled",fillcolor="white"];
"Account" -> "Account_a0" [label="",dir=none];
"Account" -> "Account_a1" [label="",dir=none];
"Wallet" -> "Wallet_a0" [label="",dir=none];
"Wallet" -> "Wallet_a1" [label="",dir=none];
"CoinEntry" -> "CoinEntry_a0" [label="",dir=none];
"CoinEntry" -> "CoinEntry_a1" [label="",dir=none];
"Contribution" -> "Contribution_a0" [label="",dir=none];
"Contribution" -> "Contribution_a1" [label="",dir=none];
"Account" -> "rel12" [label="1",dir=none];
"rel12" -> "Wallet" [label="1",dir=none];
"Account" -> "rel13" [label="1",dir=none];
"rel13" -> "CoinEntry" [label="0..N",dir=none];
"CoinEntry" -> "rel14" [label="1",dir=none];
"rel14" -> "Contribution" [label="0..1",dir=none];
"Account" -> "rel15" [label="1",dir=none];
"rel15" -> "Contribution" [label="0..N",dir=none];
}