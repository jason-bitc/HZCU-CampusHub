digraph G {
graph [rankdir=LR,nodesep=0.30,ranksep=0.48,bgcolor="white",splines=polyline,pad=0.20];
node [fontname="Microsoft YaHei",fontsize=13,color="#223846",penwidth=1.25,margin="0.10,0.07",style="rounded,filled",fillcolor="#F6F8FA"];
edge [fontname="Microsoft YaHei",fontsize=10,color="#526775",arrowsize=0.7];
"Account" [shape=box,label="账号",style="filled",fillcolor="white"];
"Profile" [shape=box,label="个人资料",style="filled",fillcolor="white"];
"Certification" [shape=box,label="校园认证",style="filled",fillcolor="white"];
"Major" [shape=box,label="校内专业",style="filled",fillcolor="white"];
"Account_a0" [shape=ellipse,label=<<U>ID 主标识</U>>,style="filled",fillcolor="white"];
"Account_a1" [shape=ellipse,label="校园邮箱",style="filled",fillcolor="white"];
"Profile_a0" [shape=ellipse,label=<<U>账号ID 主标识</U>>,style="filled",fillcolor="white"];
"Profile_a1" [shape=ellipse,label="昵称",style="filled",fillcolor="white"];
"Certification_a0" [shape=ellipse,label=<<U>账号ID 主标识</U>>,style="filled",fillcolor="white"];
"Certification_a1" [shape=ellipse,label="认证状态",style="filled",fillcolor="white"];
"Major_a0" [shape=ellipse,label=<<U>专业ID 主标识</U>>,style="filled",fillcolor="white"];
"Major_a1" [shape=ellipse,label="专业名",style="filled",fillcolor="white"];
"rel0" [shape=diamond,label="拥有",style="filled",fillcolor="white"];
"rel1" [shape=diamond,label="验证",style="filled",fillcolor="white"];
"rel2" [shape=diamond,label="归属",style="filled",fillcolor="white"];
"Account" -> "Account_a0" [label="",dir=none];
"Account" -> "Account_a1" [label="",dir=none];
"Profile" -> "Profile_a0" [label="",dir=none];
"Profile" -> "Profile_a1" [label="",dir=none];
"Certification" -> "Certification_a0" [label="",dir=none];
"Certification" -> "Certification_a1" [label="",dir=none];
"Major" -> "Major_a0" [label="",dir=none];
"Major" -> "Major_a1" [label="",dir=none];
"Account" -> "rel0" [label="1",dir=none];
"rel0" -> "Profile" [label="0..1",dir=none];
"Account" -> "rel1" [label="1",dir=none];
"rel1" -> "Certification" [label="0..1",dir=none];
"Major" -> "rel2" [label="1",dir=none];
"rel2" -> "Profile" [label="0..N",dir=none];
}