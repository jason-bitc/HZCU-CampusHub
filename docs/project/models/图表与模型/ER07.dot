"ReadProgress_a0" [shape=ellipse,label=<<U>进度ID 主标识</U>>,style="filled",fillcolor="white"];
"ReadProgress_a1" [shape=ellipse,label="账号标识",style="filled",fillcolor="white"];
"rel25" [shape=diamond,label="接收通知",style="filled",fillcolor="white"];
