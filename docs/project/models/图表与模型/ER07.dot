"rel27" [shape=diamond,label="阅读对象",style="filled",fillcolor="white"];
"Account" -> "Account_a0" [label="",dir=none];
"Account" -> "Account_a1" [label="",dir=none];
"Article" -> "Article_a0" [label="",dir=none];
"Article" -> "Article_a1" [label="",dir=none];
"Notification" -> "Notification_a0" [label="",dir=none];
"Notification" -> "Notification_a1" [label="",dir=none];
"ReadProgress" -> "ReadProgress_a0" [label="",dir=none];
"ReadProgress" -> "ReadProgress_a1" [label="",dir=none];
"Account" -> "rel25" [label="1",dir=none];
"rel25" -> "Notification" [label="0..N",dir=none];
