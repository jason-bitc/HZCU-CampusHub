digraph G {
graph [rankdir=LR,nodesep=0.30,ranksep=0.48,bgcolor="white",splines=polyline,pad=0.20];
node [fontname="Microsoft YaHei",fontsize=13,color="#223846",penwidth=1.25,margin="0.10,0.07",style="rounded,filled",fillcolor="#F6F8FA"];
edge [fontname="Microsoft YaHei",fontsize=10,color="#526775",arrowsize=0.7];
"Account" [shape=box,label="账号",style="filled",fillcolor="white"];
"Case" [shape=box,label="举报反馈",style="filled",fillcolor="white"];
"ModerationAction" [shape=box,label="处理动作",style="filled",fillcolor="white"];
"AdminIdentity" [shape=box,label="管理身份",style="filled",fillcolor="white"];
"OpsJob" [shape=box,label="运维任务",style="filled",fillcolor="white"];
"Backup" [shape=box,label="备份清单",style="filled",fillcolor="white"];
"rel16" [shape=diamond,label="提交",style="filled",fillcolor="white"];
"rel17" [shape=diamond,label="处理",style="filled",fillcolor="white"];
"rel18" [shape=diamond,label="执行",style="filled",fillcolor="white"];
"rel19" [shape=diamond,label="发起",style="filled",fillcolor="white"];
"rel20" [shape=diamond,label="产出",style="filled",fillcolor="white"];
"Account" -> "rel16" [label="1",dir=none];
"rel16" -> "Case" [label="0..N",dir=none];
"Case" -> "rel17" [label="1",dir=none];
"rel17" -> "ModerationAction" [label="0..N",dir=none];
"AdminIdentity" -> "rel18" [label="1",dir=none];
"rel18" -> "ModerationAction" [label="0..N",dir=none];
"AdminIdentity" -> "rel19" [label="1",dir=none];
"rel19" -> "OpsJob" [label="0..N",dir=none];
"OpsJob" -> "rel20" [label="1",dir=none];
"rel20" -> "Backup" [label="0..1",dir=none];
}