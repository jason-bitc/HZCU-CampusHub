digraph G {
graph [rankdir=LR,nodesep=0.30,ranksep=0.48,bgcolor="white",splines=polyline,pad=0.20];
node [fontname="Microsoft YaHei",fontsize=13,color="#223846",penwidth=1.25,margin="0.10,0.07",style="rounded,filled",fillcolor="#F6F8FA"];
edge [fontname="Microsoft YaHei",fontsize=10,color="#526775",arrowsize=0.7];
"P3" [shape=circle,label="P3\n交流与激励",style="filled",fillcolor="white"];
"P4" [shape=circle,label="P4\n社区治理",style="filled",fillcolor="white"];
"E1" [shape=box,label="E1\n平台用户"];
"E2" [shape=box,label="E2\n社区管理员"];
"D1" [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="5"><TR><TD BORDER="1" SIDES="TB">D1 账号认证资料</TD></TR></TABLE>>];
"D2" [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="5"><TR><TD BORDER="1" SIDES="TB">D2 经验版本与文件</TD></TR></TABLE>>];
"D3" [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="5"><TR><TD BORDER="1" SIDES="TB">D3 评论认可收藏</TD></TR></TABLE>>];
"D4" [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="5"><TR><TD BORDER="1" SIDES="TB">D4 奖励币与贡献</TD></TR></TABLE>>];
"D5" [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="5"><TR><TD BORDER="1" SIDES="TB">D5 举报反馈与处置</TD></TR></TABLE>>];
"P1" [shape=circle,label="P1\n身份与权限",style="filled",fillcolor="white"];
"P2" [shape=circle,label="P2\n经验内容",style="filled",fillcolor="white"];
"E1" -> "P3" [label="F01.3"];
"P3" -> "E1" [label="F02.3"];
"E1" -> "P4" [label="F01.4"];
"P4" -> "E1" [label="F02.4"];
"E2" -> "P4" [label="F03"];
"P4" -> "E2" [label="F04"];
"P3" -> "D1" [label="I07"];
"D1" -> "P3" [label="I08"];
"P3" -> "D2" [label="I09"];
"D2" -> "P3" [label="I10"];
"P3" -> "D3" [label="I11"];
"D3" -> "P3" [label="I12"];
"P3" -> "D4" [label="I13"];
"D4" -> "P3" [label="I14"];
"P4" -> "D5" [label="I15"];
"D5" -> "P4" [label="I16"];
"P4" -> "P2" [label="I17"];
"P2" -> "P4" [label="I18"];
"P4" -> "P3" [label="I19"];
"P3" -> "P4" [label="I20"];
"P4" -> "P1" [label="I21"];
"P1" -> "P4" [label="I22"];
"P3" -> "D5" [label="I27"];
"D5" -> "P3" [label="I28"];
}