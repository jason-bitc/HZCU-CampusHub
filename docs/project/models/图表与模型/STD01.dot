digraph G {
graph [rankdir=TB,nodesep=0.30,ranksep=0.48,bgcolor="white",splines=polyline,pad=0.20];
node [fontname="Microsoft YaHei",fontsize=13,color="#223846",penwidth=1.25,margin="0.10,0.07",style="rounded,filled",fillcolor="#F6F8FA"];
edge [fontname="Microsoft YaHei",fontsize=10,color="#526775",arrowsize=0.7];
"start" [shape=point,label="",style="filled",fillcolor="white",fillcolor="black",width=0.14];
"U" [shape=box,label="未注册"];
"S" [shape=box,label="待邮件验证"];
"V" [shape=box,label="已认证"];
"R" [shape=box,label="认证撤销"];
"start" -> "U" [label=""];
"U" -> "S" [label="T01"];
"S" -> "S" [label="T02"];
"S" -> "V" [label="T03"];
"S" -> "S" [label="T04"];
"V" -> "R" [label="T05"];
"R" -> "V" [label="T06"];
}