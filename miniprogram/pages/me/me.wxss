@import '../../styles/sections.wxss';

.my-page {
  padding: 16rpx 28rpx calc(156rpx + env(safe-area-inset-bottom));
}

.identity-card,
.overview-card,
.service-card,
.my-entries button {
  border-radius: 22rpx;
  background: var(--color-surface);
}

.identity-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  width: 100% !important;
  padding: 26rpx 28rpx;
  text-align: left;
  white-space: normal;
}

.profile-mark {
  flex: 0 0 90rpx;
  width: 90rpx;
  height: 90rpx;
  padding: 12rpx;
  border-radius: 20rpx;
  background: var(--color-primary-soft);
}

.profile-copy {
  flex: 1;
  min-width: 0;
}

.profile-name {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.35;
  overflow-wrap: anywhere;
}

.profile-detail {
  margin-top: 4rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  overflow-wrap: anywhere;
}

.profile-copy .status-tag {
  margin-top: 9rpx;
  font-size: 22rpx;
}

.service-heading {
  display: block;
  margin: 28rpx 0 12rpx;
  color: var(--color-text);
  font-size: 34rpx;
  font-weight: 650;
  line-height: 1.35;
}

.overview-card {
  padding: 24rpx 16rpx;
}

.overview-metrics {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.overview-metric {
  min-width: 0;
  padding: 0 8rpx;
  text-align: center;
}

.overview-metric + .overview-metric {
  border-left: 1rpx solid var(--color-border);
}

.metric-value,
.metric-label {
  display: block;
  overflow-wrap: anywhere;
}

.metric-value {
  color: var(--color-text);
  font-size: 46rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  line-height: 1.15;
}

.metric-label {
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  line-height: 1.4;
}

.overview-honor {
  margin: 16rpx 12rpx 0;
}

.my-entries {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
}

.my-entries button {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
  min-height: 152rpx;
  width: 100% !important;
  padding: 18rpx 6rpx 12rpx;
  color: var(--color-text);
  font-size: 25rpx;
  font-weight: 550;
  text-align: center;
  white-space: normal;
  line-height: 1.35;
}

.entry-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 62rpx;
  height: 62rpx;
  border-radius: 16rpx;
}

.entry-icon.tone-blue { background: var(--color-primary-soft); }
.entry-icon.tone-green { background: var(--color-success-soft); }
.entry-icon.tone-orange { background: var(--color-warning-soft); }
.entry-icon.tone-violet { background: var(--color-violet-soft); }

.entry-count {
  color: var(--color-text-secondary);
  font-size: 22rpx;
  font-weight: 400;
}

.unread-count {
  color: var(--color-primary-dark);
}

.service-card {
  padding: 0 26rpx;
}

.service-card .menu-row {
  gap: 16rpx;
  min-height: max(92rpx, 44px);
  white-space: normal;
}

.service-card .menu-row:last-child {
  border-bottom: 0;
}

.service-card .row-title {
  margin: 0;
  font-size: 28rpx;
}

.service-copy {
  min-width: 0;
}

.my-link-label {
  flex-shrink: 0;
  color: var(--color-primary-dark);
  font-size: 24rpx;
}
