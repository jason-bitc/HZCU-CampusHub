@import '../../styles/sections.wxss';
.my-page { padding-top: 14rpx; }
.identity-card { display: flex; align-items: center; gap: 24rpx; width: 100% !important; text-align: left; }
.profile-avatar { display: flex; align-items: center; justify-content: center; width: 94rpx; height: 94rpx; flex: 0 0 94rpx; border-radius: 50%; background: var(--color-primary-soft); color: var(--color-primary); font-size: 46rpx; font-weight: 700; }
.profile-copy { flex: 1; min-width: 0; }
.profile-name { display: block; font-size: 40rpx; font-weight: 700; line-height: 1.4; overflow-wrap: anywhere; }
.profile-copy .status-tag { margin: 12rpx 0 8rpx; }
.service-heading { display: block; margin: 28rpx 0 12rpx; color: var(--color-text); font-size: var(--font-lg); font-weight: 700; }
.my-entries { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10rpx; }
.my-entries button {
  display: flex; flex-direction: column; align-items: center; justify-content: flex-start;
  gap: 8rpx; min-width: 0; width: 100% !important; padding: 16rpx 4rpx 12rpx;
  min-height: 150rpx; border-radius: var(--radius-md); background: var(--color-surface);
  box-shadow: var(--shadow-card); color: var(--color-text); font-size: var(--font-xs); white-space: normal; line-height: 1.35;
}
.entry-icon { display: flex; align-items: center; justify-content: center; width: 60rpx; height: 60rpx; border-radius: 18rpx; }
.entry-icon.tone-blue { background: var(--color-primary-soft); }
.entry-icon.tone-green { background: var(--color-success-soft); }
.entry-icon.tone-orange { background: var(--color-warning-soft); }
.entry-icon.tone-violet { background: var(--color-violet-soft); }
.entry-count { color: var(--color-text-secondary); font-size: 22rpx; }
.wallet-card {
  display: block; width: 100% !important; padding: 24rpx; border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md); text-align: left; background: var(--color-surface);
  color: var(--color-text); box-shadow: var(--shadow-card);
}
.wallet-metrics { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18rpx; font-size: 27rpx; }
.wallet-metric { display: block; margin-top: 8rpx; color: var(--color-primary-dark); font-size: 54rpx; line-height: 1.2; font-weight: 700; font-variant-numeric: tabular-nums; }
.wallet-caption { display: block; margin-top: 18rpx; color: var(--color-text-secondary); font-size: 25rpx; }
.my-links { padding-top: 4rpx; padding-bottom: 4rpx; }
.my-links .menu-row { gap: 16rpx; }
.my-links .menu-row:last-child { border-bottom: 0; }
.my-links .row-title { margin: 0; }
.my-link-label { flex-shrink: 0; color: var(--color-primary-dark); font-size: 27rpx; }
