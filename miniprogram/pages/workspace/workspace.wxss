@import '../../styles/sections.wxss';
@import '../../styles/flow.wxss';
.workspace-filters { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); }
.workspace-filters button { padding: 6rpx 4rpx; min-width: 0; white-space: normal; }
.workspace-article-heading { display: flex; flex-wrap: wrap; align-items: start; gap: 8rpx 12rpx; }
.workspace-title { flex: 1 1 68%; min-width: 0; margin: 0; overflow-wrap: anywhere; }
.workspace-article-heading .status-tag { flex: none; }
.workspace-actions { gap: 6rpx 16rpx; margin-top: 12rpx; }
.workspace-actions .button-secondary { flex: none; font-size: 26rpx; }
.workspace-secondary { margin-top: 0; }
.workspace-secondary .button-text { padding: 0; font-size: 26rpx; }
