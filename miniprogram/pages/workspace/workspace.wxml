<view class="member-page">
  <page-state wx:if="{{authStatus === 'checking'}}" status="loading" title="正在核验会话" />
  <page-state wx:elif="{{authStatus === 'guest'}}" status="permission" title="登录后分享你的经验" description="多篇草稿独立保存，公开发布前可以预览。" action-text="登录校园账号" bindaction="login" />
  <page-state wx:elif="{{authStatus === 'error'}}" status="error" title="会话核验失败" description="{{error}}" action-text="重试" bindaction="onShow" />
  <view wx:else><text class="form-title">我的文章与草稿</text><button class="button-primary" bindtap="create" disabled="{{busy}}">{{pendingCreate ? '核对并继续上次创建' : '写一篇经验'}}</button><text wx:if="{{pendingCreate}}" class="hint">上次创建结果未确认，继续将沿用原请求，不会另建草稿。</text>
    <view wx:for="{{items}}" wx:key="articleId" class="list-row workspace-article"><text class="row-title">{{item.title || '未命名草稿'}}</text><text class="workspace-state">{{item.stateText}} · 修订 {{item.revision}}</text><text class="hint">{{item.updatedText}}</text><view class="inline-actions"><button wx:if="{{item.state !== 'DELETED'}}" class="button-secondary" data-id="{{item.articleId}}" bindtap="edit">{{item.state === 'ADMIN_HIDDEN' ? '查看草稿' : '继续编辑'}}</button><button wx:if="{{item.state === 'PUBLISHED'}}" class="button-secondary" data-id="{{item.articleId}}" bindtap="read">查看公开文章</button></view><view class="inline-actions"><button wx:if="{{item.state === 'PUBLISHED'}}" class="button-text" data-id="{{item.articleId}}" data-action="unpublish" bindtap="state" disabled="{{busy}}">下架</button><button wx:if="{{item.state === 'AUTHOR_OFFLINE'}}" class="button-text" data-id="{{item.articleId}}" data-action="restore" bindtap="state" disabled="{{busy}}">恢复上次公开版本</button></view><text wx:if="{{item.state === 'ADMIN_HIDDEN'}}" class="hint">管理员隐藏的内容不能自行修改、发布或恢复。</text></view>
    <text wx:if="{{loaded && !items.length}}" class="load-end">还没有文章，从第一篇草稿开始。</text><text wx:if="{{busy}}" class="load-end">正在处理…</text><button wx:elif="{{items.length < total}}" class="button-secondary" bindtap="retry">继续加载</button><text wx:if="{{error}}" class="field-error">{{error}}</text><button wx:if="{{error}}" class="button-secondary" bindtap="retry" disabled="{{busy}}">重新读取文章状态</button>
  </view>
</view>
