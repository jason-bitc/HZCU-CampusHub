<view class="member-page">
  <view wx:if="{{demoMode}}" class="demo-note">发现页处于演示模式。账号操作仍连接实际后端。</view>
  <view class="auth-intro"><text class="form-title">{{mode === 'login' ? '继续你的求职准备' : title}}</text><text class="form-lead">网页与小程序使用同一校园账号，公开经验可免费阅读。</text></view>
  <view class="field"><text class="field-label">校园邮箱</text><input class="field-input" value="{{email}}" data-field="email" bindinput="input" maxlength="82" disabled="{{busy || sending}}" placeholder="name@stu.hzcu.edu.cn" aria-label="校园邮箱" /><text wx:if="{{errors.email}}" class="field-error">{{errors.email}}</text></view>
  <view wx:if="{{mode !== 'login'}}" class="field"><text class="field-label">6 位邮箱验证码</text><view class="code-row"><input class="field-input" value="{{code}}" data-field="code" bindinput="input" type="number" maxlength="6" disabled="{{busy}}" placeholder="输入验证码" aria-label="邮箱验证码" /><button class="button-secondary" bindtap="sendCode" loading="{{sending}}" disabled="{{busy || sending || wait > 0}}">{{wait > 0 ? wait + '秒后重发' : '获取验证码'}}</button></view><text wx:if="{{errors.code}}" class="field-error">{{errors.code}}</text><text wx:if="{{expired}}" class="field-error">验证码已过期，请重新获取。</text><text class="hint">5 分钟内有效。60 秒可重发，同邮箱同用途每小时最多 5 次。</text></view>
  <view class="field"><text class="field-label">{{mode === 'login' ? '密码' : '设置密码'}}</text><input class="field-input" value="{{password}}" password data-field="password" bindinput="input" maxlength="-1" disabled="{{busy}}" aria-label="密码" placeholder="输入应用登录密码" /><text wx:if="{{errors.password}}" class="field-error">{{errors.password}}</text></view>
  <view wx:if="{{mode !== 'login'}}" class="field"><text class="field-label">确认密码</text><input class="field-input" value="{{confirmation}}" password data-field="confirmation" bindinput="input" maxlength="-1" disabled="{{busy}}" aria-label="确认密码" placeholder="再次输入密码" /><text wx:if="{{errors.confirmation}}" class="field-error">{{errors.confirmation}}</text></view>
  <text wx:if="{{error}}" class="field-error" role="alert">{{error}}</text><text wx:if="{{notice}}" class="success-note">{{notice}}</text>
  <view class="form-actions"><button class="button-primary" bindtap="submit" loading="{{busy}}" disabled="{{busy || sending}}">{{mode === 'login' ? '登录' : mode === 'register' ? '验证邮箱并创建账号' : '核验并更新密码'}}</button></view>
  <view class="auth-links"><button wx:if="{{mode !== 'register'}}" class="button-text" data-mode="register" bindtap="switchMode">用校园邮箱注册</button><button wx:if="{{mode !== 'login'}}" class="button-text" data-mode="login" bindtap="switchMode">返回登录</button><button wx:if="{{mode === 'login'}}" class="button-text" data-mode="reset" bindtap="switchMode">忘记密码</button></view>
  <button class="button-text" bindtap="browse">暂不登录，继续免费阅读</button><view class="notice form-section">仅开放 stu.hzcu.edu.cn 校园邮箱注册。校园关联认证不代表文章或经历真实性。</view>
</view>
