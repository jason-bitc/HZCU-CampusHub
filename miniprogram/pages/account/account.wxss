@import '../../styles/flow.wxss';
.auth-links { display: flex; flex-wrap: wrap; justify-content: space-between; margin: 20rpx 0; }
.account-page .auth-intro { display: block; margin-bottom: 28rpx; }
.account-form { padding-top: 0; padding-bottom: 0; }
.account-form .field {
  display: grid;
  grid-template-columns: 158rpx minmax(0, 1fr);
  align-items: center;
  gap: 0 12rpx;
  margin: 0;
  padding: 10rpx 0;
}
.account-form .field + .field { border-top: 1rpx solid var(--color-border); }
.account-form .field-label { margin: 0; }
.account-form .field-input { min-width: 0; padding: 0; border: 0; background: transparent; }
.account-form .code-row { min-width: 0; gap: 6rpx; }
.account-form .code-row .button-secondary { padding: 0 8rpx; font-size: var(--font-xs); }
.account-form .hint, .account-form .field-error { grid-column: 1 / -1; }
.account-form .success-note, .account-form .field-error { padding-bottom: 8rpx; }
.account-page .form-actions button { width: 100% !important; }
