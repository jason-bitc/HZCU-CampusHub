<view class="member-page"><page-state wx:if="{{authStatus === 'checking'}}" status="loading" title="正在核验会话" /><page-state wx:elif="{{authStatus === 'guest'}}" status="permission" title="登录后查看非现金币" action-text="登录校园账号" bindaction="login" /><page-state wx:elif="{{authStatus === 'error'}}" status="error" title="会话核验失败" description="{{error}}" action-text="重试" bindaction="onShow" />
  <view wx:else><view wx:if="{{wallet && rewards}}"><text class="wallet-balance">可用余额 {{wallet.balance}} 币</text><text class="hint">收到的有效贡献 {{wallet.receivedContribution}} 币。不可购买、提现或兑换现金，投币不能自行撤回。</text><text class="section-title">今日奖励 · {{rewards.businessDate}}</text><text class="hint">登录 {{rewards.rules.loginReward}} 币，阅读满 {{rewards.rules.readingSeconds}} 秒可领 {{rewards.rules.readingReward}} 币。每日各一次，服务端判断资格。</text><view class="form-actions"><button class="button-secondary" data-kind="login" bindtap="claim" disabled="{{busy || !pendingLogin && !rewards.login.eligible}}">{{pendingLogin ? '核对上次登录奖励' : rewards.login.claimed ? '今日登录奖励已领' : '领取今日登录奖励'}}</button><button class="button-secondary" data-kind="reading" bindtap="claim" disabled="{{busy || !pendingReading && !readySession || rewards.reading.claimed && !pendingReading}}">{{pendingReading ? '核对上次阅读奖励' : rewards.reading.claimed ? '今日阅读奖励已领' : '领取今日阅读奖励'}}</button></view><text wx:if="{{readingSeconds !== null && !rewards.reading.claimed}}" class="hint">{{readingSeconds > 0 ? '最近阅读会话还需约 ' + readingSeconds + ' 秒' : '已有达到计时门槛的阅读会话，领取时由服务端再次核验'}}</text><text wx:elif="{{!rewards.reading.claimed}}" class="hint">登录后阅读一篇公开文章，阅读会话将由服务端计时。</text><text class="section-title">本人账目</text><view wx:for="{{ledger}}" wx:key="eventId" class="list-row"><text class="row-title">{{item.action === 'LOGIN_REWARD' ? '登录奖励' : item.action === 'READING_REWARD' ? '阅读奖励' : '文章投币'}} · {{item.delta > 0 ? '+' : ''}}{{item.delta}}</text><text class="hint">{{item.occurredAt}} · 当时余额 {{item.balanceAfter}}</text><text wx:if="{{item.articleId}}" class="hint">文章编号 {{item.articleId}}</text></view><text wx:if="{{!ledger.length}}" class="hint">还没有账目记录。</text><button wx:if="{{ledger.length < total}}" class="button-secondary" bindtap="more" disabled="{{busy}}">继续读取本次账目快照</button></view><text wx:if="{{error}}" class="field-error">{{error}}</text><text wx:if="{{notice}}" class="success-note">{{notice}}</text><button class="button-text form-section" bindtap="load" loading="{{busy}}" disabled="{{busy}}">刷新钱包与资格</button></view>
</view>
