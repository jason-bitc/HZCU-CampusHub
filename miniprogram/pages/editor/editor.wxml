<page-meta page-style="{{tocDrawerVisible ? 'overflow: hidden;' : ''}}" />
<view class="member-page">
  <page-state wx:if="{{authStatus === 'checking'}}" status="loading" title="正在核验会话" />
  <page-state wx:elif="{{authStatus === 'guest'}}" status="permission" title="登录后继续编辑" description="{{error}} 未确认保存的编辑副本仅供原账号重新登录后恢复。" action-text="登录校园账号" bindaction="login" />
  <page-state wx:elif="{{authStatus === 'error'}}" status="error" title="无法核验会话" description="{{error}}" action-text="重新核验" bindaction="onShow" />
  <view wx:else>
    <text wx:if="{{form}}" class="editor-status">{{stateText}} · 修订 {{revision}} · {{dirty ? '有修改待保存' : '当前内容已确认'}} </text>
    <button wx:if="{{hasBackup && !conflict}}" class="button-text" bindtap="backup">查看保留的冲突副本</button>
    <view wx:if="{{complexSource}}" class="notice">复杂 Markdown 暂不支持在小程序内修改。原文已完整保留，可预览或复制到完整编辑器继续处理。</view>
    <view wx:elif="{{readOnly}}" class="notice">这篇内容处于不可编辑状态，可以查看和复制草稿，不能自行发布或恢复。</view>
    <button wx:if="{{readOnly}}" class="button-secondary form-section" bindtap="copyBody">复制原始 Markdown 正文</button>
    <view wx:if="{{complexSource && articleState !== 'ADMIN_HIDDEN'}}" class="notice form-section">在电脑端使用同一校园账号，打开网页工作区继续编辑云端草稿。</view>
    <button wx:if="{{complexSource && webHandoff && articleState !== 'ADMIN_HIDDEN'}}" class="button-secondary form-section" bindtap="copyWebEditor">复制网页编辑地址</button>
    <button wx:if="{{publishRestricted}}" class="button-secondary form-section" bindtap="appeals">查看发布限制与申诉</button>
    <view wx:if="{{recovery}}" class="list-row"><text class="row-title">发现本机编辑副本</text><text class="hint">{{recovery.savedAt}} · 基于修订 {{recovery.baseRevision}}。云端内容已载入，选择后再继续。</text><view class="form-actions"><button class="button-secondary" bindtap="recover" disabled="{{readOnly}}">恢复本机副本并核对修订</button><button class="button-secondary" bindtap="copyRecovery">复制完整本机副本</button><button class="button-text" bindtap="keepServer">继续使用当前云端内容</button></view></view>
    <view wx:if="{{form}}">
      <text wx:if="{{notice}}" class="success-note">{{notice}}</text><text wx:if="{{error}}" class="field-error">{{error}}</text>
      <view wx:if="{{conflict}}" class="list-row"><text class="section-title">草稿版本冲突</text><text class="hint">本机修订 {{revision}}，云端修订 {{conflict.latest.revision}}。当前输入保留，尚未覆盖云端。</text><text class="section-title">云端最新内容</text><scroll-view scroll-y class="conflict-content"><view wx:for="{{conflict.serverRows}}" wx:key="label" class="field"><text class="field-label">{{item.label}}</text><text>{{item.value}}</text></view></scroll-view><text class="section-title">本机编辑副本</text><scroll-view scroll-y class="conflict-content"><view wx:for="{{conflict.localRows}}" wx:key="label" class="field"><text class="field-label">{{item.label}}</text><text>{{item.value}}</text></view></scroll-view><view class="form-actions"><button class="button-secondary" bindtap="copy">复制完整本机副本</button><button class="button-secondary" data-keep="server" bindtap="resolve">保留副本并采用云端版本</button><button class="button-secondary" data-keep="local" bindtap="resolve">已比较，保留本机内容继续编辑</button></view></view>
      <view wx:if="{{pendingPublish}}" class="list-row"><text class="row-title">发布结果待核对</text><button class="button-primary form-section" bindtap="retryPublish" disabled="{{busy}}">沿用原请求核对发布结果</button><button class="button-text" bindtap="reconcile">读取当前云端状态</button><text wx:if="{{reconciled}}" class="hint">云端 {{reconciled.state}} · 修订 {{reconciled.revision}}</text><button wx:if="{{reconciled}}" class="button-text" bindtap="viewPublished">查看当前公开文章</button><button wx:if="{{reconciled}}" class="button-secondary" bindtap="endPending">已核对，停止重试并处理差异</button></view>
      <view wx:if="{{!preview}}">
        <view class="field"><text class="field-label">标题</text><input class="field-input" value="{{form.title}}" maxlength="-1" data-field="title" bindinput="input" disabled="{{busy || readOnly || conflict || pendingPublish}}" aria-label="文章标题" /></view>
        <view wx:for="{{tagGroups}}" wx:key="field" class="field"><text class="field-label">{{item.label}}</text><view class="tag-options"><button wx:for="{{item.items}}" wx:for-item="tag" wx:key="id" class="tag-option {{tag.selected ? 'tag-selected' : ''}}" data-id="{{tag.id}}" data-field="{{item.field}}" bindtap="toggleTag" disabled="{{busy || readOnly || conflict || pendingPublish}}">{{tag.name}}{{tag.selected ? ' · 已选' : ''}}</button></view></view>
        <view class="field"><text class="field-label">经历发生时的阶段</text><input class="field-input" value="{{form.experienceStage}}" data-field="experienceStage" bindinput="input" maxlength="-1" disabled="{{busy || readOnly || conflict || pendingPublish}}" placeholder="如：大二暑假，需自行确认" aria-label="经历发生时的阶段" /></view>
        <button class="menu-row" bindtap="toggleHints"><text>写作提示（可跳过）</text><text class="menu-note">{{hintsVisible ? '收起' : '展开'}}</text></button><text wx:if="{{hintsVisible}}" class="notice">可以写当时基础、准备过程、投递面试、结果与不足，以及资料来源。无需逐项回答，不要求提供工资、成绩或证明。</text>
        <view class="field"><text class="field-label">正文／原始 Markdown</text><textarea class="field-textarea body-input" value="{{form.body}}" data-field="body" bindinput="input" maxlength="-1" disabled="{{busy || readOnly || conflict || pendingPublish}}" aria-label="文章正文" /></view>
        <text wx:if="{{!blockSupported}}" class="hint">检测到复杂 Markdown，原文完整保留。请在源码中编辑，段落重排已关闭，避免破坏格式。</text>
        <view class="inline-actions"><button class="button-secondary" bindtap="addText" disabled="{{busy || readOnly || conflict || pendingPublish}}">添加文字</button><button class="button-secondary" bindtap="chooseImages" disabled="{{busy || readOnly || conflict || pendingPublish}}">添加图片</button></view><text class="hint">JPEG / PNG，每张不超过 10MiB、2500 万像素。可多次选择，不设固定业务张数上限。</text>
        <view wx:for="{{uploads}}" wx:key="requestId" class="list-row"><text class="row-title">图片 {{index + 1}} · {{item.state === 'done' ? '已上传并插入正文' : item.state === 'failed' ? '上传失败' : '等待上传'}}</text><secure-image wx:if="{{item.image}}" url="{{item.image.url}}" /><text wx:if="{{item.error}}" class="field-error">{{item.error}}</text><view wx:if="{{item.state !== 'done'}}" class="inline-actions"><button class="button-secondary" data-index="{{index}}" bindtap="retryUpload" disabled="{{busy || pendingPublish}}">沿用原文件重试</button><button class="button-text" data-index="{{index}}" bindtap="removeUpload" disabled="{{busy || pendingPublish}}">移除失败项</button></view></view>
        <button wx:if="{{blockSupported}}" class="button-text" bindtap="toggleOrder">{{orderVisible ? '收起段落顺序' : '调整段落与图片顺序'}}</button>
        <view wx:if="{{orderVisible && blockSupported}}"><view wx:for="{{blocks}}" wx:key="index" class="list-row"><text class="field-label">第 {{index + 1}} 段 · {{item.kind}}</text><text class="block-caption">{{item.caption}}</text><view class="inline-actions"><button class="button-text" data-index="{{index}}" data-delta="-1" bindtap="move" disabled="{{busy || readOnly || conflict || pendingPublish || index === 0}}">上移</button><button class="button-text" data-index="{{index}}" data-delta="1" bindtap="move" disabled="{{busy || readOnly || conflict || pendingPublish || index === blocks.length - 1}}">下移</button><button class="button-text danger-action" data-index="{{index}}" bindtap="removeBlock" disabled="{{busy || readOnly || conflict || pendingPublish}}">移除</button></view></view></view>
        <view class="field"><text class="field-label">摘要（可选，发布时可自动生成）</text><textarea class="field-textarea" value="{{form.summary}}" data-field="summary" bindinput="input" maxlength="-1" disabled="{{busy || readOnly || conflict || pendingPublish}}" aria-label="文章摘要" /></view>
        <view class="field"><text class="field-label">内容来源</text><picker range="{{sourceNames}}" value="{{sourceIndex}}" bindchange="source" disabled="{{busy || readOnly || conflict || pendingPublish}}"><view class="field-picker">{{sourceNames[sourceIndex]}}</view></picker></view>
        <view class="field"><text class="field-label">来源说明（整理内容必填）</text><textarea class="field-textarea" value="{{form.sourceNote}}" data-field="sourceNote" bindinput="input" maxlength="-1" disabled="{{busy || readOnly || conflict || pendingPublish}}" aria-label="来源说明" /></view>
        <view wx:for="{{form.sourceLinks}}" wx:key="index" class="list-row"><text class="field-label">资料 {{index + 1}} 名称</text><input class="field-input" value="{{item.label}}" data-index="{{index}}" data-field="label" bindinput="linkInput" maxlength="-1" disabled="{{busy || readOnly || conflict || pendingPublish}}" /><text class="field-label">http / https 链接</text><input class="field-input" value="{{item.url}}" data-index="{{index}}" data-field="url" bindinput="linkInput" maxlength="-1" disabled="{{busy || readOnly || conflict || pendingPublish}}" /><button class="button-text" data-index="{{index}}" bindtap="removeLink" disabled="{{busy || readOnly || conflict || pendingPublish}}">移除链接</button></view><button class="button-secondary form-section" bindtap="addLink" disabled="{{busy || readOnly || conflict || pendingPublish}}">添加资料链接（可选）</button>
      </view>
      <view wx:else class="editor-preview"><text class="form-title">{{form.title || '未填写标题'}}</text><text class="hint">经历阶段：{{form.experienceStage || '未填写'}} · {{sourceNames[sourceIndex]}}</text><markdown-view body="{{form.body}}" asset-base-url="{{assetBaseUrl}}" private-mode="{{true}}" source-links="{{form.sourceLinks}}" source-note="{{form.sourceNote}}" binddrawerchange="drawer" bindsources="previewSources" /><text id="preview-sources" class="section-title">来源说明</text><text class="plain-text">{{form.sourceNote || '未填写'}}</text><view wx:for="{{form.sourceLinks}}" wx:key="index" class="hint">{{item.label}} · {{item.url}}</view><view class="notice form-section">发布后标题、正文、图片、分类与来源将向游客公开。未发布草稿仍只对本人可见。</view><button class="button-primary form-section" bindtap="requestPublish" disabled="{{busy || readOnly || conflict || pendingPublish}}">确认并发布</button></view>
      <view class="form-footer"><button class="button-secondary" bindtap="save" disabled="{{busy || readOnly || conflict || pendingPublish}}" loading="{{busy}}">保存草稿</button><button class="button-primary" bindtap="preview" disabled="{{busy}}">{{preview ? complexSource ? '查看字段' : '返回编辑' : '预览'}}</button></view>
    </view>
    <view wx:elif="{{!busy}}"><text class="field-error">{{error}}</text><button class="button-secondary" bindtap="load">重新读取草稿</button></view><text wx:else class="hint">正在读取草稿…</text>
  </view>
</view>
