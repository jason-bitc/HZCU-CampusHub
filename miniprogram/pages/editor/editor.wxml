<page-meta page-style="{{tocDrawerVisible ? 'overflow: hidden;' : ''}}" />
<view class="member-page flow-page editor-page">
  <page-state wx:if="{{authStatus === 'checking'}}" status="loading" title="正在核验会话" />
  <page-state wx:elif="{{authStatus === 'guest'}}" status="permission" title="登录后继续编辑" description="{{error}} 未确认保存的编辑副本仅供原账号重新登录后恢复。" action-text="登录校园账号" bindaction="login" />
  <page-state wx:elif="{{authStatus === 'error'}}" status="error" title="无法核验会话" description="{{error}}" action-text="重新核验" bindaction="onShow" />
  <view wx:else>
    <text wx:if="{{form}}" class="editor-status" role="status">{{stateText}} · {{saving ? '正在保存到云端…' : conflict ? '需要核对版本' : dirty ? '有修改未保存' : '已载入云端内容'}} </text>
    <button wx:if="{{hasBackup && !conflict}}" class="button-text" bindtap="backup">查看保留的冲突副本</button>
    <view wx:if="{{complexSource}}" class="notice">复杂 Markdown 暂不支持在小程序内修改。原文已完整保留，可预览或复制到完整编辑器继续处理。</view>
    <view wx:elif="{{readOnly}}" class="notice">这篇内容处于不可编辑状态，可以查看和复制草稿，不能自行发布或恢复。</view>
    <button wx:if="{{readOnly}}" class="button-secondary form-section" bindtap="copyBody">复制原始 Markdown 正文</button>
    <view wx:if="{{complexSource && articleState !== 'ADMIN_HIDDEN'}}" class="notice form-section">在电脑端使用同一校园账号，打开网页工作区继续编辑云端草稿。</view>
    <button wx:if="{{complexSource && webHandoff && articleState !== 'ADMIN_HIDDEN'}}" class="button-secondary form-section" bindtap="copyWebEditor">复制网页编辑地址</button>
    <button wx:if="{{publishRestricted}}" class="button-secondary form-section" bindtap="appeals">查看发布限制与申诉</button>
    <view wx:if="{{recovery}}" class="list-row"><text class="row-title">发现本机编辑副本</text><text class="hint">{{recovery.savedAt}} · 基于修订 {{recovery.baseRevision}}。云端内容已载入，选择后再继续。</text><view class="form-actions"><button class="button-secondary" bindtap="recover" disabled="{{readOnly}}">恢复本机副本并核对修订</button><button class="button-secondary" bindtap="copyRecovery">复制完整本机副本</button><button class="button-text" bindtap="keepServer">继续使用当前云端内容</button></view></view>
    <view wx:if="{{form}}">
      <text wx:if="{{notice}}" class="success-note">{{notice}}</text><text wx:if="{{error}}" class="field-error">{{error}}</text>
      <view id="draft-conflict" wx:if="{{conflict}}" class="flow-card editor-conflict"><text class="section-title">草稿版本冲突</text><text class="hint">本机修订 {{revision}}，云端修订 {{conflict.latest.revision}}。当前输入保留，尚未覆盖云端。</text><text class="section-title">云端最新内容</text><scroll-view scroll-y class="conflict-content"><view wx:for="{{conflict.serverRows}}" wx:key="label" class="field"><text class="field-label">{{item.label}}</text><text>{{item.value}}</text></view></scroll-view><text class="section-title">本机编辑副本</text><scroll-view scroll-y class="conflict-content"><view wx:for="{{conflict.localRows}}" wx:key="label" class="field"><text class="field-label">{{item.label}}</text><text>{{item.value}}</text></view></scroll-view><view class="form-actions"><button class="button-secondary" bindtap="copy">复制完整本机副本</button><button class="button-secondary" data-keep="server" bindtap="resolve">保留副本并采用云端版本</button><button class="button-secondary" data-keep="local" bindtap="resolve">已比较，保留本机内容继续编辑</button></view></view>
      <view wx:if="{{pendingPublish}}" class="list-row"><text class="row-title">发布结果待核对</text><button class="button-primary form-section" bindtap="retryPublish" disabled="{{busy}}">沿用原请求核对发布结果</button><button class="button-text" bindtap="reconcile">读取当前云端状态</button><text wx:if="{{reconciled}}" class="hint">云端 {{reconciled.state}} · 修订 {{reconciled.revision}}</text><button wx:if="{{reconciled}}" class="button-text" bindtap="viewPublished">查看当前公开文章</button><button wx:if="{{reconciled}}" class="button-secondary" bindtap="endPending">已核对，停止重试并处理差异</button></view>
      <view class="editor-mode flow-tabs" role="tablist" aria-label="切换写正文和预览">
        <button class="{{preview ? '' : 'selected'}}" bindtap="showWriting" disabled="{{complexSource}}" role="tab" aria-selected="{{!preview}}">写正文</button>
        <button class="{{preview ? 'selected' : ''}}" bindtap="showPreview" disabled="{{busy}}" role="tab" aria-selected="{{preview}}">看预览</button>
      </view>
      <view hidden="{{preview}}" id="draft-writing">
        <view class="flow-card editor-section">
        <view id="draft-title" class="field"><text class="field-label">标题</text><input class="field-input" cursor-spacing="108" value="{{form.title}}" maxlength="-1" data-field="title" bindinput="input" disabled="{{busy || readOnly || conflict || pendingPublish || recovery}}" aria-label="文章标题" /></view>
        <view id="draft-body" class="field"><text class="field-label">正文</text><textarea cursor-spacing="108" class="field-textarea body-input" value="{{form.body}}" data-field="body" bindinput="input" maxlength="-1" disabled="{{busy || readOnly || conflict || pendingPublish || recovery}}" aria-label="文章正文" /></view>
        <button class="menu-row" bindtap="toggleHints"><text>写作提示（可跳过）</text><text class="menu-note">{{hintsVisible ? '收起' : '展开'}}</text></button><view wx:if="{{hintsVisible}}" class="notice"><text wx:if="{{loadingPrompts}}" class="hint">正在读取写作提示…</text><text wx:if="{{promptsError}}" class="field-error">{{promptsError}}</text><text wx:if="{{prompts && !prompts.length}}" class="hint">暂无写作提示。</text><view wx:for="{{prompts}}" wx:key="id"><text class="row-title">{{item.title}}</text><text class="hint">{{item.question}}</text></view></view>
        <text wx:if="{{!blockSupported}}" class="hint">检测到复杂 Markdown，原文完整保留。请在源码中编辑，段落重排已关闭，避免破坏格式。</text>
        </view>
        <view id="draft-images" class="flow-card editor-section editor-images"><text class="section-title">图片与段落</text><view class="inline-actions"><button class="button-secondary" bindtap="addText" disabled="{{busy || readOnly || conflict || pendingPublish || recovery}}">添加文字</button><button class="button-secondary" bindtap="chooseImages" disabled="{{uploading || busy || readOnly || conflict || pendingPublish || recovery}}">添加图片</button></view><text class="hint">每张图片支持 JPEG 或 PNG，最大 10 MiB、2500 万像素。</text>
        <text wx:if="{{uploading}}" class="hint" role="status">正在上传图片，可以继续编辑正文。</text>
        <view wx:for="{{uploads}}" wx:key="requestId" class="list-row"><text class="row-title">图片 {{index + 1}} · {{item.state === 'done' ? '已上传并插入正文' : item.state === 'failed' ? '上传失败' : item.state === 'uploading' ? '正在上传…' : '等待上传'}}</text><secure-image wx:if="{{item.image}}" url="{{item.image.url}}" /><text wx:if="{{item.error}}" class="field-error">{{item.error}}</text><view wx:if="{{item.state === 'failed'}}" class="inline-actions"><button class="button-secondary" data-index="{{index}}" bindtap="retryUpload" disabled="{{uploading || busy || pendingPublish}}">重试原图片</button><button class="button-text" data-index="{{index}}" bindtap="removeUpload" disabled="{{uploading || busy || pendingPublish}}">移除图片</button></view></view>
        <button wx:if="{{blockSupported}}" class="button-text" bindtap="toggleOrder">{{orderVisible ? '收起段落顺序' : '调整段落与图片顺序'}}</button>
        <view wx:if="{{orderVisible && blockSupported}}"><view wx:for="{{blocks}}" wx:key="index" class="list-row"><text class="field-label">第 {{index + 1}} 段 · {{item.kind}}</text><text class="block-caption">{{item.caption}}</text><view class="inline-actions"><button class="button-text" data-index="{{index}}" data-delta="-1" bindtap="move" disabled="{{busy || readOnly || conflict || pendingPublish || recovery || index === 0}}">上移</button><button class="button-text" data-index="{{index}}" data-delta="1" bindtap="move" disabled="{{busy || readOnly || conflict || pendingPublish || recovery || index === blocks.length - 1}}">下移</button><button class="button-text danger-action" data-index="{{index}}" bindtap="removeBlock" disabled="{{busy || readOnly || conflict || pendingPublish || recovery}}">移除</button></view></view></view>
        </view>
        <view id="publish-details" class="publish-details flow-card editor-section">
          <button class="menu-row" bindtap="toggleDetails" aria-expanded="{{detailsOpen}}"><text>发布信息</text><text class="menu-note">{{detailsOpen ? '收起' : '分类、经历阶段与来源'}}</text></button>
          <view wx:if="{{detailsOpen}}">
        <view wx:for="{{tagGroups}}" wx:key="field" id="draft-tags-{{item.field}}" class="field"><text class="field-label">{{item.label}}</text><view class="tag-options"><button wx:for="{{item.items}}" wx:for-item="tag" wx:key="id" class="tag-option {{tag.selected ? 'tag-selected' : ''}}" data-id="{{tag.id}}" data-field="{{item.field}}" bindtap="toggleTag" disabled="{{busy || readOnly || conflict || pendingPublish || recovery}}">{{tag.name}}{{tag.selected ? ' · 已选' : ''}}</button></view></view>
        <view id="draft-stage" class="field"><text class="field-label">经历发生时的阶段</text><input class="field-input" cursor-spacing="108" value="{{form.experienceStage}}" data-field="experienceStage" bindinput="input" maxlength="-1" disabled="{{busy || readOnly || conflict || pendingPublish || recovery}}" placeholder="如：大二暑假" aria-label="经历发生时的阶段" /></view>
        <view class="field"><text class="field-label">摘要（可选，发布时可自动生成）</text><textarea cursor-spacing="108" class="field-textarea" value="{{form.summary}}" data-field="summary" bindinput="input" maxlength="-1" disabled="{{busy || readOnly || conflict || pendingPublish || recovery}}" aria-label="文章摘要" /></view>
        <view id="draft-source" class="field"><text class="field-label">内容来源</text><picker range="{{sourceNames}}" value="{{sourceIndex}}" bindchange="source" disabled="{{busy || readOnly || conflict || pendingPublish || recovery}}"><view class="field-picker">{{sourceNames[sourceIndex]}}</view></picker></view>
        <view id="draft-source-note" class="field"><text class="field-label">来源说明（整理内容必填）</text><textarea cursor-spacing="108" class="field-textarea" value="{{form.sourceNote}}" data-field="sourceNote" bindinput="input" maxlength="-1" disabled="{{busy || readOnly || conflict || pendingPublish || recovery}}" aria-label="来源说明" /></view>
        <view wx:for="{{form.sourceLinks}}" wx:key="index" class="list-row"><text class="field-label">资料 {{index + 1}} 名称</text><input class="field-input" cursor-spacing="108" value="{{item.label}}" data-index="{{index}}" data-field="label" bindinput="linkInput" maxlength="-1" disabled="{{busy || readOnly || conflict || pendingPublish || recovery}}" /><text class="field-label">http / https 链接</text><input class="field-input" cursor-spacing="108" value="{{item.url}}" data-index="{{index}}" data-field="url" bindinput="linkInput" maxlength="-1" disabled="{{busy || readOnly || conflict || pendingPublish || recovery}}" /><button class="button-text" data-index="{{index}}" bindtap="removeLink" disabled="{{busy || readOnly || conflict || pendingPublish || recovery}}">移除链接</button></view><button class="button-secondary form-section" bindtap="addLink" disabled="{{busy || readOnly || conflict || pendingPublish || recovery}}">添加资料链接（可选）</button>
          </view>
        </view>
      </view>
      <view wx:if="{{preview}}" class="editor-preview">
        <view wx:if="{{publishIssues.length}}" class="publish-checklist">
          <text class="section-title">发布前还需完成</text>
          <button wx:for="{{publishIssues}}" wx:key="target" class="publish-issue menu-row" data-target="{{item.target}}" bindtap="completePublishDetails">{{item.label}}<app-icon name="chevron-right" size="24" /></button>
        </view>
        <text class="form-title">{{form.title || '未填写标题'}}</text><text class="hint">经历阶段：{{form.experienceStage || '未填写'}} · {{sourceNames[sourceIndex]}}</text><markdown-view body="{{form.body}}" asset-base-url="{{assetBaseUrl}}" private-mode="{{true}}" source-links="{{form.sourceLinks}}" source-note="{{form.sourceNote}}" binddrawerchange="drawer" bindsources="previewSources" /><text id="preview-sources" class="section-title">来源说明</text><text class="plain-text">{{form.sourceNote || '未填写'}}</text><view wx:for="{{form.sourceLinks}}" wx:key="index" class="hint">{{item.label}} · {{item.url}}</view><view class="notice form-section">发布后标题、正文、图片、分类与来源将向游客公开。未发布草稿仍只对本人可见。</view>
      </view>
      <view class="form-footer editor-footer">
        <text class="editor-footer-status" role="status">{{saving ? '正在保存到云端…' : conflict ? '云端版本有更新，请核对' : pendingPublish ? '发布结果待核对' : dirty ? '有修改未保存' : cloudSaved ? '已保存到云端' : '已载入云端内容'}}</text>
        <view class="editor-footer-actions"><button class="{{preview ? 'button-text' : 'button-secondary'}}" bindtap="save" disabled="{{uploading || busy || readOnly || conflict || pendingPublish || recovery}}" loading="{{saving}}">保存草稿</button><button class="{{preview ? 'button-secondary' : 'button-primary'}}" bindtap="preview" disabled="{{busy}}">{{preview ? complexSource ? '查看字段' : '返回编辑' : '预览'}}</button><button wx:if="{{preview}}" class="button-primary" bindtap="requestPublish" disabled="{{uploading || busy || readOnly || conflict || pendingPublish || recovery || confirmingPublish || publishIssues.length}}">确认并发布</button></view>
      </view>
    </view>
    <view wx:elif="{{!busy}}"><text class="field-error">{{error}}</text><button class="button-secondary" bindtap="load">重新读取草稿</button></view><text wx:else class="hint">正在读取草稿…</text>
  </view>
</view>
