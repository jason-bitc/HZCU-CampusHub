<view class="detail-page">
  <button wx:if="{{demoMode}}" class="demo-banner pressable" bindtap="chooseDemoScenario">演示模式 · 本地示例正文，未连接真实后端 · 点击切换状态</button>

  <page-state wx:if="{{status === 'loading'}}" status="loading" title="正在加载经验" description="正在获取当前公开版本，请稍候。" />
  <page-state wx:elif="{{status === 'error'}}" status="error" title="文章加载失败" description="{{errorMessage}}。可以手动重试，不会把服务异常显示成没有正文。" trace-id="{{traceId}}" action-text="重试当前请求" secondary-text="返回发现页" bindaction="loadArticle" bindsecondary="goBack" />
  <page-state wx:elif="{{status === 'unavailable'}}" status="unavailable" title="内容不可用" description="{{errorMessage}}。不会展示缓存中的旧正文、作者资料或评论。" trace-id="{{traceId}}" action-text="返回发现页" bindaction="goBack" />

  <view wx:else class="detail-content">
    <view class="article-container">
      <view class="article-header">
        <view class="source-tag">{{article.sourceText}}</view>
        <text class="article-title">{{article.title}}</text>
        <text class="article-meta">{{article.publishedText}} 发布 · {{article.jobText}}</text>
        <view class="article-tags">
          <text>{{article.majorText}}</text>
          <text wx:if="{{article.companyText}}">{{article.companyText}}</text>
          <text wx:if="{{article.topicText}}">{{article.topicText}}</text>
        </view>
        <view class="stage-box">
          <text class="stage-label">经历阶段</text>
          <text class="stage-value">{{article.experienceStage}}</text>
        </view>
        <view class="guest-note">作者身份与主页、联系方式、评论等受限资料不向游客展示；公开正文可完整免费阅读。</view>
      </view>

      <markdown-view body="{{article.body}}" asset-base-url="{{assetBaseUrl}}" />

      <view class="source-section">
        <text class="source-heading">来源与外部资料</text>
        <text class="source-note">{{article.sourceNote || '作者未补充来源说明。'}}</text>
        <view wx:if="{{article.sourceLinks.length}}" class="source-links">
          <button wx:for="{{article.sourceLinks}}" wx:key="url" class="source-link pressable" data-url="{{item.url}}" bindtap="copySourceLink">
            <view class="source-link-text">
              <text class="source-link-label">{{item.label}}</text>
              <text class="source-link-url">{{item.url}}</text>
            </view>
            <text class="copy-label">复制链接</text>
          </button>
        </view>
        <view wx:else class="source-empty">本文没有附加外部资料链接。</view>
        <text class="source-disclaimer">外部内容由读者自愿访问，平台不代管站外账号或访问授权。</text>
      </view>
    </view>
    <view class="permission-rule">本批不包含点赞、投币、收藏、评论、作者联系与认证账号功能。</view>
  </view>
  <view class="bottom-safe"></view>
</view>
