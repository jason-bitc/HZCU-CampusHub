<page-meta page-style="{{tocDrawerVisible ? 'overflow: hidden;' : ''}}" />
<import src="../../templates/honor.wxml" />
<view class="detail-page {{memberError || pendingCoin || actionNotice ? 'detail-with-feedback' : ''}}">
  <view wx:if="{{demoMode}}" class="demo-banner">演示模式 · 本地示例，未连接真实后端</view>

  <page-state wx:if="{{status === 'loading'}}" status="loading" title="正在加载经验" description="正在获取当前公开版本，请稍候。" />
  <page-state wx:elif="{{status === 'error'}}" status="error" title="{{errorTitle}}" description="{{errorMessage}}。可以重试或返回发现页。" trace-id="{{traceId}}" action-text="重试当前请求" secondary-text="返回发现页" bindaction="loadArticle" bindsecondary="goBack" />
  <page-state wx:elif="{{status === 'unavailable' || status === 'permission'}}" status="{{status}}" title="内容不可用" description="{{errorMessage}}" trace-id="{{traceId}}" action-text="返回发现页" bindaction="goBack" />

  <view wx:else class="detail-content">
    <view class="article-container">
      <view class="article-header">
        <text class="article-title">{{article.title}}</text>
        <view class="article-attribution">
          <button wx:if="{{author}}" class="author-link" bindtap="author">{{author.nickname}}<text class="menu-note">查看作者</text></button>
          <button wx:elif="{{!authenticated && !demoMode}}" class="button-text author-login" bindtap="login">登录查看作者</button>
          <text class="article-date">{{article.publishedText}}发布</text>
        </view>
        <template is="author-honor" data="{{honor: author.honor}}" wx:if="{{author && author.honor}}" />
        <view class="article-tags">
          <text class="source-tag">{{article.sourceText}}</text>
          <text>{{article.jobText}}</text>
          <text>{{article.majorText}}</text>
          <text wx:if="{{article.companyText}}">{{article.companyText}}</text>
          <text wx:if="{{article.topicText}}">{{article.topicText}}</text>
        </view>
        <text class="article-meta">{{article.experienceStage}} · {{article.jobNatureText}} · 当时基础 {{article.baseLevelText}}</text>
        <text wx:if="{{authenticated && !author && !privateLoading && !memberError}}" class="hint">当前文章没有可访问的作者主页。</text>
        <text wx:if="{{privateLoading}}" class="hint">正在读取本人互动状态…</text>
      </view>

      <markdown-view id="article-reader" demo-mode="{{demoMode}}" body="{{article.body}}" asset-base-url="{{assetBaseUrl}}" source-links="{{article.sourceLinks}}" source-note="{{article.sourceNote}}" binddrawerchange="handleDrawerChange" bindsources="goToSources" />

      <view id="article-sources" class="source-section">
        <text class="source-heading">来源与外部资料</text>
        <text class="source-note">{{article.sourceNote || '作者未补充来源说明。'}}</text>
        <view class="source-links">
          <button wx:for="{{article.sourceLinks}}" wx:key="url" class="source-link pressable" data-url="{{item.url}}" bindtap="copySourceLink">
            <view class="source-link-text">
              <text class="source-link-label">{{item.label}}</text>
              <text class="source-link-url">{{item.url}}</text>
            </view>
            <text class="copy-label">复制链接</text>
          </button>
        </view>
        <text class="source-disclaimer">外部内容由读者自愿访问，请自行核验内容与访问权限。</text>
      </view>
      <button wx:if="{{!demoMode}}" class="button-text article-report" bindtap="report">举报这篇经验</button>
    </view>
  </view>

  <view wx:if="{{status === 'ready'}}" class="visitor-action-bar" role="toolbar" aria-label="文章互动操作">
    <view wx:if="{{memberError || pendingCoin && !busyAction}}" class="interaction-feedback interaction-error" role="alert">
      <text>{{memberError || '投币结果待确认，核对时会沿用原请求。'}}</text>
      <button wx:if="{{memberError && !pendingCoin}}" class="button-text" bindtap="refreshMember" disabled="{{busyAction || privateLoading}}">核对状态</button>
    </view>
    <text wx:elif="{{actionNotice && !busyAction}}" class="interaction-feedback" role="status">{{actionNotice}}</text>
    <view class="visitor-action-row">
    <button class="visitor-action {{interaction.liked ? 'action-selected' : ''}}" data-kind="like" bindtap="toggleInteraction" disabled="{{demoMode || busyAction || coinChoosing || privateLoading || authenticated && !interaction}}" aria-pressed="{{!!interaction.liked}}" aria-label="{{interaction.liked ? '取消点赞' : '点赞'}}">
      <view class="reader-action-icon"><app-icon name="like" size="38" /></view>
      <text>{{busyAction === 'like' ? '处理中…' : interaction.liked ? '已赞 ' + article.effectiveLikes : '点赞 ' + article.effectiveLikes}}</text>
    </button>
    <button class="visitor-action" bindtap="coins" disabled="{{demoMode || busyAction || coinChoosing || privateLoading || authenticated && !pendingCoin && !coinState || authenticated && !pendingCoin && !wallet}}" aria-label="{{pendingCoin ? '核对投币' : '投币'}}">
      <view class="reader-action-icon"><app-icon name="coin" size="38" /></view>
      <text>{{busyAction === 'coin' ? '核对中…' : pendingCoin ? '核对投币' : '投币 ' + article.effectiveCoins}}</text>
    </button>
    <button class="visitor-action {{interaction.favorited ? 'action-selected' : ''}}" data-kind="favorite" bindtap="toggleInteraction" disabled="{{demoMode || busyAction || coinChoosing || privateLoading || authenticated && !interaction}}" aria-pressed="{{!!interaction.favorited}}" aria-label="{{interaction.favorited ? '取消收藏' : '收藏'}}">
      <view class="reader-action-icon"><app-icon name="star" size="38" /></view>
      <text>{{busyAction === 'favorite' ? '处理中…' : interaction.favorited ? '已收藏' : '收藏'}}</text>
    </button>
    <button class="visitor-action" bindtap="comments" disabled="{{demoMode || busyAction || coinChoosing || privateLoading}}" aria-label="评论">
      <view class="reader-action-icon"><app-icon name="comment" size="38" /></view>
      <text>评论</text>
    </button>
    </view>
  </view>
  <view class="bottom-safe"></view>
</view>
