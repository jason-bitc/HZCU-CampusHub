.detail-page {
  min-height: 100vh;
  padding-bottom: 126rpx;
  background: var(--color-surface);
}

.demo-banner {
  width: 100%;
  padding: 14rpx 28rpx;
  background: var(--color-warning-soft);
  color: var(--color-warning);
  font-size: var(--font-xs);
  line-height: 1.5;
  text-align: center;
}

.detail-content {
  max-width: 800px;
  margin: 0 auto;
  padding: 28rpx var(--page-gutter) 32rpx;
}

.article-header {
  display: flex;
  flex-direction: column;
  padding-bottom: 22rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.source-tag {
  align-self: flex-start;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  background: var(--color-primary-soft);
  color: var(--color-primary-dark);
  font-size: var(--font-xs);
  font-weight: 600;
}

.article-title {
  color: var(--color-text);
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.4;
  letter-spacing: -0.4rpx;
  overflow-wrap: anywhere;
}

.article-meta {
  margin-top: 14rpx;
  color: var(--color-text-secondary);
  font-size: var(--font-xs);
  line-height: 1.6;
}

.article-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
  color: var(--color-text-secondary);
  font-size: var(--font-xs);
}
.article-container markdown-view { display: block; margin-top: 24rpx; }

.source-note { display: block; margin-top: 20rpx; color: var(--color-text-secondary); font-size: var(--font-sm); white-space: pre-wrap; overflow-wrap: anywhere; }

.source-section {
  margin-top: 44rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid var(--color-border);
}

.source-heading {
  display: block;
  font-size: var(--font-lg);
  font-weight: 650;
}

.source-links {
  margin-top: 20rpx;
}

.source-link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  width: 100% !important;
  margin-top: 14rpx;
  padding: 20rpx 22rpx;
  border-radius: var(--radius-sm);
  background: var(--color-primary-soft);
  text-align: left;
}

.source-link-text {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.source-link-label {
  color: var(--color-primary-dark);
  font-size: var(--font-sm);
  font-weight: 600;
}

.source-link-url {
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: var(--font-xs);
  line-height: 1.5;
  word-break: break-all;
}

.copy-label {
  flex: none;
  color: var(--color-primary);
  font-size: var(--font-xs);
  font-weight: 600;
}

.source-disclaimer {
  display: block;
  margin-top: 18rpx;
  color: var(--color-text-tertiary);
  font-size: var(--font-xs);
  line-height: 1.7;
}


.visitor-action-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  padding: 10rpx 12rpx calc(10rpx + constant(safe-area-inset-bottom));
  padding: 10rpx 12rpx calc(10rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--color-border);
  background: var(--color-surface);
}
.visitor-action-row { display: flex; align-items: stretch; }
.interaction-feedback { display: block; padding: 8rpx 18rpx; color: var(--color-primary-dark); font-size: var(--font-xs); overflow-wrap: anywhere; }
.interaction-error { display: flex; align-items: center; gap: 8rpx; color: var(--color-danger); }
.interaction-error text { flex: 1; min-width: 0; }
.interaction-error button { flex: none; }

.visitor-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  width: 25% !important;
  min-height: 92rpx;
  color: var(--color-text-secondary) !important;
  opacity: 1 !important;
  background: transparent !important;
  font-size: 24rpx;
  line-height: 1.3;
}

.bottom-safe {
  height: calc(18rpx + constant(safe-area-inset-bottom));
  height: calc(18rpx + env(safe-area-inset-bottom));
}
.visitor-action.action-selected { color: var(--color-primary) !important; font-weight: 650; }
.visitor-action[disabled] { opacity: 0.64 !important; }

.article-report { padding-left: 0; color: var(--color-text-secondary); font-size: 28rpx; }


.reader-action-icon { display: flex; justify-content: center; align-items: center; width: 58rpx; height: 46rpx; border-radius: 14rpx; }
.action-selected .reader-action-icon { background: var(--color-primary-soft); }
.visitor-action:active .reader-action-icon { background: var(--color-bg); }

.article-attribution { display: flex; align-items: center; gap: 16rpx; margin-top: 16rpx; }
.article-byline { flex: 1; min-width: 0; }
.author-link, .author-login { display: flex; min-height: var(--touch-target); align-items: center; flex-wrap: wrap; gap: 4rpx 12rpx; padding: 0; color: var(--color-primary-dark); font-size: 28rpx; font-weight: 600; text-align: left; white-space: normal; overflow-wrap: anywhere; }
.article-date, .author-link .menu-note { color: var(--color-text-secondary); font-size: 24rpx; font-weight: 400; }
.author-login { align-self: flex-start; color: var(--color-text-secondary); font-size: var(--font-xs); font-weight: 500; }
.article-tags text { padding: 3rpx 12rpx; border-radius: 999rpx; background: var(--color-control); line-height: 1.55; }
.article-tags .source-tag { color: var(--color-primary-dark); background: var(--color-primary-soft); }

.article-toc-slot { flex: 0 0 44px; height: 44px; }
.article-toc {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 3rpx;
  width: 44px !important;
  height: 44px;
  padding: 0;
  border: 1rpx solid var(--color-border);
  border-radius: 12rpx;
  background: var(--color-surface);
  color: var(--color-primary-dark);
  font-size: var(--font-xs);
  line-height: 1.1;
}
.article-toc-pinned {
  position: fixed;
  z-index: 90;
  top: 0;
  right: 0;
  left: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 6px var(--page-gutter);
  border-bottom: 1rpx solid var(--color-border);
  background: var(--color-surface);
}
.article-toc-pinned .article-toc { flex: 0 0 44px; }
.article-current-chapter {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: var(--color-text-secondary);
  font-size: var(--font-sm);
  white-space: nowrap;
  text-overflow: ellipsis;
}
.article-toc:active { background: var(--color-selected); }
.guest-actions { gap: 16rpx; padding: 8rpx 14rpx; }
.guest-actions button { flex: 1; min-width: 0; padding: 0 14rpx; font-size: var(--font-sm); }
.guest-actions .button-primary { flex: 2; }
.visitor-action { min-height: var(--touch-target); }
.visitor-action-row > button { min-width: 0; }
.interaction-error { flex-wrap: wrap; }
.detail-with-feedback { padding-bottom: 196rpx; }
