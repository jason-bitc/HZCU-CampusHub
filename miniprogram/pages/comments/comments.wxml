<template name="comment-content">
  <view wx:if="{{comment.available}}"><button wx:if="{{comment.commenter.authorId}}" class="comment-author" data-id="{{comment.commenter.authorId}}" bindtap="author">{{comment.commenter.nickname}} · 作者主页</button><text wx:else class="hint">{{comment.commenter ? comment.commenter.nickname : '用户资料不可用'}}</text><text wx:if="{{comment.replyTo}}" class="hint">回复 {{comment.replyTo.available ? comment.replyTo.commenter.nickname : '不可用评论'}}</text><text class="comment-body" user-select>{{comment.body}}</text><secure-image wx:for="{{comment.images}}" wx:key="imageId" url="{{item.url}}" /><text class="hint">{{comment.createdText}}</text><view class="inline-actions"><button class="button-text" data-id="{{comment.commentId}}" data-name="{{comment.commenter.nickname}}" bindtap="reply" disabled="{{busy || pendingComment}}">回复</button><button wx:if="{{comment.canDelete}}" class="button-text danger-action" data-id="{{comment.commentId}}" bindtap="remove" disabled="{{busy}}">删除本人评论</button></view></view><text wx:else class="hint">这条评论当前不可用，正文和历史资料不再展示。</text>
</template>
<view class="member-page">
  <page-state wx:if="{{authStatus === 'checking'}}" status="loading" title="正在核验会话" /><page-state wx:elif="{{authStatus === 'guest'}}" status="permission" title="登录后查看与发表评论" description="{{error}}" action-text="登录校园账号" bindaction="login" /><page-state wx:elif="{{authStatus === 'error'}}" status="error" title="会话核验失败" description="{{error}}" action-text="重试" bindaction="onShow" />
  <view wx:else>
    <button wx:if="{{rootId}}" class="button-secondary" bindtap="roots">返回全部主评论</button><text class="form-title">{{rootId ? '评论回复' : '评论'}}</text><view wx:if="{{root}}" class="list-row"><text class="field-label">主评论</text><template is="comment-content" data="{{comment:root,busy:busy,pendingComment:pendingComment}}" /></view>
    <view wx:for="{{items}}" wx:key="commentId" class="list-row"><template is="comment-content" data="{{comment:item,busy:busy,pendingComment:pendingComment}}" /><button wx:if="{{!rootId && item.replyCount}}" class="button-text" data-id="{{item.commentId}}" bindtap="thread" disabled="{{busy}}">查看 {{item.replyCount}} 条回复</button></view><text wx:if="{{loaded && !items.length}}" class="hint">还没有{{rootId ? '回复' : '评论'}}。</text><button wx:if="{{items.length < total}}" class="button-secondary" bindtap="more" disabled="{{busy}}">继续加载</button>
    <view class="separator"></view><text class="section-title">{{replyTo ? '回复 ' + replyTo.nickname : '写一条评论'}}</text><button wx:if="{{replyTo}}" class="button-text" bindtap="cancelReply" disabled="{{pendingComment || busy}}">取消回复对象</button><textarea class="field-textarea" value="{{body}}" maxlength="-1" bindinput="input" disabled="{{busy || pendingComment}}" placeholder="真实交流，尊重他人" aria-label="评论文字" />
    <view wx:for="{{uploads}}" wx:key="requestId" class="list-row"><secure-image wx:if="{{item.image}}" url="{{item.image.url}}" /><text class="hint">图片 {{index + 1}} · {{item.state === 'done' ? '已上传' : '等待上传或失败'}}</text><text class="field-error">{{item.error}}</text><view class="inline-actions"><button wx:if="{{item.state !== 'done'}}" class="button-secondary" data-index="{{index}}" bindtap="retryImage" disabled="{{busy || pendingComment}}">原文件重试</button><button class="button-text" data-index="{{index}}" bindtap="removeImage" disabled="{{busy || pendingComment}}">移除图片</button></view></view>
    <button class="button-secondary form-section" bindtap="chooseImages" disabled="{{busy || pendingComment}}">添加 JPEG / PNG 图片</button><text class="hint">每张不超过 10MiB。评论按普通文字显示，不执行 HTML。</text><text wx:if="{{pendingComment}}" class="notice form-section">上次提交结果尚未确认，文字和图片已冻结。重试会保留原请求及内容。</text><text wx:if="{{error}}" class="field-error">{{error}}</text><text wx:if="{{notice}}" class="success-note">{{notice}}</text><view class="form-actions"><button class="button-primary" bindtap="send" loading="{{busy}}" disabled="{{busy}}">{{pendingComment ? '沿用原请求核对评论结果' : '提交评论'}}</button><button class="button-secondary" bindtap="copy">复制待提交文字</button><button class="button-text" bindtap="retry" disabled="{{busy}}">刷新评论</button><button wx:if="{{pendingComment}}" class="button-secondary" bindtap="stopRetry" disabled="{{busy}}">已核对列表，保留副本并停止重试</button></view>
  </view>
</view>
