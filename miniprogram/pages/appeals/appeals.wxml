<view class="member-page">
  <page-state wx:if="{{authStatus === 'checking'}}" status="loading" title="正在核验会话" />
  <page-state wx:elif="{{authStatus === 'guest'}}" status="permission" title="登录后查看本人限制与申诉" action-text="登录校园账号" bindaction="login" />
  <page-state wx:elif="{{authStatus === 'error'}}" status="error" title="会话核验失败" description="{{error}}" action-text="重试" bindaction="onShow" />
  <view wx:else>
    <view wx:if="{{loaded && activeCount}}" class="limit-banner">部分行为当前受限。公开文章仍可阅读，草稿可保存，也可以提交本人申诉。</view>
    <view wx:elif="{{loaded}}" class="notice">当前没有生效的行为限制。</view>
    <view wx:for="{{restrictions}}" wx:key="id" class="section-card appeal-card {{selected.id === item.id ? 'selected' : ''}}">
      <view class="status-heading"><text class="row-title">处理决定 #{{item.id}}</text><text class="status-tag {{item.enabled ? 'danger' : ''}}">{{item.enabled ? '受限' : '已解除'}}</text></view>
      <text class="hint">{{item.scopeText}} · 版本 {{item.revision}} · {{item.updatedText}}</text>
      <text class="section-copy" user-select>{{item.reason}}</text>
      <button wx:if="{{item.enabled && !item.pendingReview}}" class="button-text" data-id="{{item.id}}" bindtap="select" disabled="{{busy || pending || !loaded}}">{{selected.id === item.id ? '已选此决定' : '申诉此决定'}}</button>
      <text wx:elif="{{item.pendingReview}}" class="hint">这个版本已有待复核的申诉。</text>
    </view>
    <view wx:if="{{selected || pending || reason}}" class="field appeal-reason">
      <text class="field-label">申诉说明 *</text>
      <text wx:if="{{selected}}" class="hint">对应决定 #{{selected.id}} · 版本 {{selected.revision}}</text>
      <textarea class="field-textarea" value="{{reason}}" bindinput="input" maxlength="-1" disabled="{{busy || pending}}" placeholder="补充事实、理由或需要复核的信息" aria-label="申诉说明" />
      <text wx:if="{{pending}}" class="hint">上次提交结果待确认，可以继续核对原申诉。</text>
      <button class="button-primary form-section" bindtap="submit" loading="{{busy}}" disabled="{{busy || !pending && !loaded || !pending && !selected}}">{{pending ? '核对上次申诉' : '提交申诉'}}</button>
    </view>
    <text wx:if="{{error}}" class="field-error" role="alert">{{error}}</text>
    <text wx:if="{{notice}}" class="success-note" role="status">{{notice}}</text>
    <text class="section-title">本人申诉记录</text>
    <view wx:for="{{records}}" wx:key="id" class="section-card">
      <view class="status-heading"><text class="row-title">申诉 #{{item.id}}</text><text class="status-tag">{{item.stateText}}</text></view>
      <text class="hint">决定 #{{item.restrictionId}} · 版本 {{item.restrictionRevision}} · {{item.updatedText}}</text>
      <text class="section-copy" user-select>{{item.reason}}</text>
      <text wx:if="{{item.reply}}" class="section-copy" user-select>复核答复：{{item.reply}}</text>
    </view>
    <text wx:if="{{loaded && !records.length}}" class="hint">还没有申诉记录。</text>
    <button wx:if="{{records.length < total}}" class="button-secondary" bindtap="more" disabled="{{busy}}">继续加载申诉</button>
    <text wx:if="{{busy}}" class="load-end">正在读取或提交…</text>
    <button class="button-secondary form-section" bindtap="refresh" disabled="{{busy}}">重新读取处理状态</button>
    <view class="notice appeal-footer">解除行为限制不会自动恢复被隐藏的文章，内容恢复由社区处理人员另行核对。</view>
  </view>
</view>
