<page-meta page-style="{{filterVisible ? 'overflow: hidden;' : ''}}" />
<view class="discover-page">
  <view wx:if="{{demoMode}}" class="demo-banner">演示模式 · 本地示例，未连接真实后端</view>

  <view class="page-content">
    <view class="discover-controls">
    <view class="search-box">
      <view class="search-field">
        <app-icon name="search" size="36" />
        <input class="search-input" value="{{keywordInput}}" maxlength="100" confirm-type="search" placeholder="搜索经验标题或摘要" placeholder-class="input-placeholder" aria-label="搜索经验标题或摘要" bindinput="handleKeywordInput" bindconfirm="submitSearch" />
        <button wx:if="{{keywordInput}}" class="search-clear pressable" bindtap="clearSearch" aria-label="清空关键词">
          <app-icon name="close" size="30" />
        </button>
      </view>
      <button class="search-submit button-primary" bindtap="submitSearch" aria-label="提交搜索">搜索</button>
    </view>
    <text wx:if="{{searchError}}" class="field-error" role="alert">{{searchError}}</text>

    <view class="filter-toolbar">
      <picker wx:if="{{jobChoices.length > 1}}" class="quick-job" range="{{jobChoices}}" range-key="name" value="{{jobChoiceIndex}}" bindchange="selectJob" aria-label="按目标岗位筛选">
        <view class="quick-control {{filters.jobId ? 'quick-selected' : ''}}">
          <text>岗位</text>
          <view class="picker-chevron" aria-hidden="true"><app-icon name="chevron-right" size="22" /></view>
        </view>
      </picker>
      <button wx:if="{{sameMajorAvailable}}" class="quick-control same-major-entry {{filters.majorId === ownMajorId ? 'quick-selected' : ''}}" aria-pressed="{{filters.majorId === ownMajorId}}" bindtap="toggleSameMajor">
        同专业<app-icon wx:if="{{filters.majorId === ownMajorId}}" name="check" size="26" />
      </button>
      <button class="quick-control filter-entry" bindtap="openFilter">
        <app-icon name="filter" size="29" /><text>组合筛选</text>
      </button>
    </view>
    <view wx:if="{{chips.length}}" class="active-filters">
      <button wx:for="{{chips}}" wx:key="key" class="extra-chip pressable" data-key="{{item.key}}" bindtap="clearChip" aria-label="移除{{item.label}}">
        <view class="chip-label"><text>{{item.label}}</text><app-icon name="close" size="22" /></view>
      </button>
      <button class="clear-conditions pressable" bindtap="resetFilters">清除条件</button>
    </view>
    <button wx:if="{{catalogError}}" class="catalog-warning" bindtap="loadCatalog">分类加载失败，筛选选项可能不完整。点击重试。</button>
    </view>

    <view class="result-heading">
      <view class="result-label">
        <text class="result-title" role="heading">经验</text>
        <text wx:if="{{listStatus === 'ready' || listStatus === 'no-match' || listStatus === 'empty'}}" class="result-count" aria-live="polite">{{total}} 篇</text>
      </view>
      <view class="sort-choice" role="tablist" aria-label="经验排序">
        <button class="sort-tab {{sort === 'recognized' ? 'sort-active' : ''}}" data-sort="recognized" bindtap="selectSort" role="tab" aria-selected="{{sort === 'recognized'}}">认可优先</button>
        <button class="sort-tab {{sort === 'latest' ? 'sort-active' : ''}}" data-sort="latest" bindtap="selectSort" role="tab" aria-selected="{{sort === 'latest'}}">最新发布</button>
      </view>
    </view>
    <page-state wx:if="{{listStatus === 'loading'}}" compact status="loading" title="正在加载公开经验" />
    <page-state wx:elif="{{listStatus === 'error'}}" compact status="error" title="{{errorTitle}}" description="{{errorMessage}}。搜索与筛选条件已保留。" trace-id="{{traceId}}" action-text="重试当前请求" secondary-text="调整筛选" bindaction="handleStateAction" bindsecondary="handleStateSecondary" />
    <page-state wx:elif="{{listStatus === 'empty'}}" compact status="no-content" title="还没有公开经验" description="有新经验发布后会出现在这里。" action-text="刷新列表" bindaction="handleStateAction" />
    <page-state wx:elif="{{listStatus === 'no-match'}}" compact status="empty" title="没有符合当前条件的经验" description="试试移除一项筛选条件。" action-text="{{filters.companyId ? '清除公司条件' : '清除全部条件'}}" secondary-text="调整筛选" bindaction="handleStateAction" bindsecondary="handleStateSecondary" />
    <view wx:elif="{{listStatus === 'ready'}}" class="article-list">
      <view wx:if="{{refreshError}}" class="notice" role="alert"><text>{{refreshError}}。下方为上次读取结果。</text><button class="button-text" bindtap="refreshResults">重试刷新</button></view>
      <article-card wx:for="{{articles}}" wx:key="id" id="feed-article-{{item.id}}" article="{{item}}" feed bindopen="openArticle" />
      <view class="load-more-area">
        <view wx:if="{{loadMoreError}}" class="notice" role="alert"><text>{{loadMoreError}}</text><button class="button-secondary" bindtap="loadMore">重试加载更多</button></view>
        <button wx:elif="{{hasMore}}" class="load-more pressable" loading="{{loadingMore}}" disabled="{{loadingMore}}" bindtap="loadMore">{{loadingMore ? '正在加载' : '继续加载更多经验'}}</button>
        <text wx:if="{{!hasMore}}" class="list-end">已读到列表末尾 · {{articles.length}} 篇</text>
      </view>
    </view>

    <text class="reader-rule">公开经验免费阅读。登录校园账号后可查看作者资料、收藏并参与交流。</text>
  </view>

  <filter-panel id="discover-filters" visible="{{filterVisible}}" filters="{{filters}}" catalog="{{catalog}}" catalog-loading="{{catalogLoading}}" catalog-error="{{catalogError}}" signed-in="{{signedIn}}" own-major-id="{{ownMajorId}}" profile-error="{{profileError}}" bindlogin="login" bindprofile="editProfile" bindretry="loadCatalog" bindclose="closeFilter" bindapply="applyFilter" />
</view>
