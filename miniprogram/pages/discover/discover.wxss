.discover-page {
  min-height: 100vh;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.demo-banner {
  width: 100%;
  padding: 14rpx 28rpx;
  background: var(--color-warning-soft);
  color: var(--color-warning);
  font-size: var(--font-xs);
  line-height: 1.5;
  text-align: center;
}

.page-content {
  padding: 0 28rpx;
}

.discover-header {
  padding: 34rpx 4rpx 24rpx;
}

.page-title {
  color: var(--color-text);
  font-size: 39rpx;
  font-weight: 700;
  line-height: 1.4;
  letter-spacing: -0.4rpx;
}

.search-box {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 96rpx;
  padding: 8rpx 22rpx;
  border-radius: var(--radius-sm);
  background: var(--color-surface);
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  font-size: var(--font-md);
}

.search-clear {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: var(--touch-target) !important;
  height: var(--touch-target);
}

.job-scroll {
  width: calc(100% + 56rpx);
  margin: 24rpx -28rpx 0;
  white-space: nowrap;
}

.job-row {
  display: inline-flex;
  gap: 14rpx;
  padding: 0 28rpx 8rpx;
}

.job-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: var(--touch-target);
  padding: 0 22rpx;
  border-radius: 8rpx;
  background: var(--color-surface);
  color: var(--color-text-secondary);
  font-size: var(--font-sm);
  white-space: nowrap;
}

.job-active {
  background: var(--color-primary);
  color: #ffffff;
  font-weight: 600;
}

.condition-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 58rpx;
  margin-top: 16rpx;
}

.summary-major {
  display: flex;
  align-items: center;
  min-width: 0;
}

.summary-label {
  flex: none;
  color: var(--color-primary);
  font-size: 25rpx;
  font-weight: 600;
}

.summary-value {
  display: flex;
  align-items: center;
  min-height: var(--touch-target);
  color: var(--color-primary);
  font-size: 25rpx;
  font-weight: 600;
}

.summary-placeholder {
  color: var(--color-text-secondary);
  font-size: 25rpx;
}

.summary-company {
  display: flex;
  flex: none;
  align-items: center;
  gap: 4rpx;
  min-height: var(--touch-target);
  color: var(--color-text-secondary);
  font-size: 25rpx;
}

.extra-conditions {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 8rpx;
}

.extra-chip {
  display: flex;
  align-items: center;
  min-height: var(--touch-target);
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background: var(--color-primary-soft);
  color: var(--color-primary-dark);
  font-size: var(--font-xs);
  line-height: 1.5;
}

.catalog-warning {
  width: 100% !important;
  margin-top: 12rpx;
  padding: 16rpx 20rpx;
  border-radius: var(--radius-sm);
  background: var(--color-danger-soft);
  color: var(--color-danger);
  font-size: var(--font-xs);
  text-align: left;
}

.sort-row {
  display: flex;
  gap: 44rpx;
  margin-top: 14rpx;
}

.sort-tab {
  position: relative;
  min-height: var(--touch-target);
  color: var(--color-text-secondary);
  font-size: 29rpx;
  font-weight: 500;
}

.sort-active {
  color: var(--color-primary);
  font-weight: 700;
}

.sort-active::after {
  position: absolute;
  right: 0;
  bottom: 6rpx;
  left: 0;
  height: 5rpx;
  border-radius: 5rpx;
  background: var(--color-primary);
  content: "";
}

.article-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 16rpx;
}

.empty-note {
  margin-top: 24rpx;
  color: var(--color-primary);
  font-size: var(--font-sm);
  line-height: 1.7;
  text-align: center;
}

.load-more-area {
  padding: 2rpx 0 8rpx;
  text-align: center;
}

.load-more {
  min-height: var(--touch-target);
  color: var(--color-primary);
  font-size: var(--font-sm);
}

.load-more-error {
  width: 100% !important;
  padding: 20rpx;
  border-radius: var(--radius-sm);
  background: var(--color-danger-soft);
  color: var(--color-danger);
  font-size: var(--font-sm);
}

.reader-rule {
  margin: 28rpx 0 24rpx;
  padding: 24rpx;
  border-radius: var(--radius-sm);
  background: var(--color-primary-soft);
  color: var(--color-primary-dark);
  font-size: var(--font-sm);
  line-height: 1.7;
  text-align: center;
}

.search-submit { flex: none; min-height: var(--touch-target); padding: 0 8rpx; color: var(--color-primary); font-size: var(--font-sm); font-weight: 600; }
.filter-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.filter-entry { display: flex; align-items: center; gap: 12rpx; min-height: var(--touch-target); color: var(--color-primary); font-size: var(--font-sm); font-weight: 600; }
.result-count, .list-end { color: var(--color-text-secondary); font-size: var(--font-xs); }
.list-end { display: block; padding: 24rpx 0; }
