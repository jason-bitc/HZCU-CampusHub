.discover-page {
  min-height: 100vh;
  padding-bottom: calc(156rpx + env(safe-area-inset-bottom));
}

.demo-banner {
  padding: 12rpx 28rpx;
  background: var(--color-warning-soft);
  color: var(--color-warning);
  font-size: 24rpx;
  text-align: center;
}

.page-content {
  padding: 16rpx 28rpx 0;
}

.search-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.search-field {
  display: flex;
  flex: 1;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
  padding: 0 16rpx;
  min-height: var(--touch-target);
  border-radius: 22rpx;
  background: #eaeef3;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: var(--touch-target);
  font-size: 28rpx;
}

.search-clear,
.search-submit {
  flex: none;
  min-height: var(--touch-target);
}

.search-clear {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: var(--touch-target);
}

.search-submit {
  padding: 0 24rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
}

.filter-toolbar {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.quick-control {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-width: var(--touch-target);
  min-height: var(--touch-target);
  padding: 0 16rpx;
  border-radius: 16rpx;
  background: var(--color-surface);
  color: var(--color-text);
  font-size: 26rpx;
  font-weight: 550;
}

.quick-job {
  display: block;
}

.quick-selected {
  background: var(--color-primary-soft);
  color: var(--color-primary-dark);
  font-weight: 650;
}

.picker-chevron {
  display: flex;
  transform: rotate(90deg);
}

.filter-entry {
  margin-left: auto !important;
}

.active-filters {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0 12rpx;
  margin-top: 4rpx;
}

.extra-chip,
.clear-conditions {
  display: flex;
  align-items: center;
  min-height: var(--touch-target);
  font-size: 24rpx;
}

.extra-chip {
  max-width: 100%;
  text-align: left;
}

.chip-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
  padding: 6rpx 12rpx;
  border-radius: 10rpx;
  background: var(--color-primary-soft);
  color: var(--color-primary-dark);
  line-height: 1.4;
}

.chip-label text {
  min-width: 0;
  overflow-wrap: anywhere;
  white-space: normal;
}

.clear-conditions {
  padding: 0 8rpx;
  color: var(--color-primary-dark);
}

.catalog-warning {
  display: block;
  width: 100% !important;
  min-height: var(--touch-target);
  padding: 10rpx 12rpx;
  color: var(--color-danger);
  font-size: 24rpx;
  text-align: left;
  white-space: normal;
}

.sort-row,
.result-heading,
.sort-choice {
  display: flex;
  align-items: center;
}

.sort-row {
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 0 12rpx;
  margin-top: 16rpx;
  margin-bottom: 8rpx;
}

.result-heading {
  align-items: baseline;
  gap: 12rpx;
}

.result-title {
  color: var(--color-text);
  font-size: 34rpx;
  font-weight: 650;
}

.result-count,
.list-end,
.reader-rule {
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.sort-choice {
  border-radius: 16rpx;
  background: #eaeef3;
}

.sort-tab {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--touch-target);
  padding: 0 16rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.sort-active {
  border-radius: 14rpx;
  background: var(--color-surface);
  color: var(--color-primary-dark);
  font-weight: 650;
}

.article-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.load-more-area {
  text-align: center;
}

.load-more {
  min-height: var(--touch-target);
  color: var(--color-primary-dark);
  font-size: 28rpx;
}

.list-end,
.reader-rule {
  display: block;
  padding: 12rpx 0;
  text-align: center;
}
