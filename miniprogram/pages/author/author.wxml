<view class="member-page"><page-state wx:if="{{authStatus === 'checking'}}" status="loading" title="正在核验会话" /><page-state wx:elif="{{authStatus === 'guest'}}" status="permission" title="登录后查看作者资料" action-text="登录校园账号" bindaction="login" /><page-state wx:elif="{{authStatus === 'error'}}" status="error" title="会话核验失败" description="{{error}}" action-text="重试" bindaction="onShow" />
  <view wx:else><view wx:if="{{author}}"><text class="form-title">{{author.nickname}}</text><text class="hint">{{author.major ? author.major.name : '未填写专业'}} · {{author.currentStage === 'ENROLLED' ? '在校' : author.currentStage === 'GRADUATED' ? '毕业' : '阶段未设置'}}</text><text class="hint">校园邮箱已验证，仅代表校园关联</text><text class="author-bio">{{author.bio || '作者暂未填写简介'}}</text><button class="button-secondary" bindtap="contact" loading="{{contactLoading}}" disabled="{{contactLoading}}">查看当前联系设置</button><view wx:if="{{contact}}" class="list-row"><text wx:if="{{!contact.enabled}}" class="hint">作者当前未开放联系方式。</text><view wx:else><text class="hint">{{contact.type}} · {{contact.value}}</text><button class="button-text" bindtap="copy">重新核对并复制</button><text class="hint">站外资料由作者提供，请自行核验。</text></view></view><text class="section-title">公开经验 · {{author.publicArticleCount}} 篇</text><article-card wx:for="{{articles}}" wx:key="id" article="{{item}}" bindopen="open" /><button wx:if="{{articles.length < total}}" class="button-secondary" bindtap="more" disabled="{{busy}}">继续加载</button></view><text wx:if="{{busy}}" class="hint">正在读取作者资料…</text><text wx:if="{{error}}" class="field-error">{{error}}</text><button wx:if="{{error}}" class="button-secondary" bindtap="onShow" disabled="{{busy}}">重新核对作者状态</button></view>
</view>
