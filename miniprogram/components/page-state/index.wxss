.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 370rpx;
  margin-top: 22rpx;
  padding: 44rpx 30rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
  text-align: center;
}

.state-compact {
  min-height: 280rpx;
  margin-top: 0;
  padding: 36rpx 24rpx;
}

.loading-button {
  margin-top: 26rpx;
}

.state-title {
  margin-top: 26rpx;
  color: var(--color-text);
  font-size: var(--font-lg);
  font-weight: 650;
  line-height: 1.45;
}

.state-description {
  max-width: 560rpx;
  margin-top: 16rpx;
  color: var(--color-text-secondary);
  font-size: var(--font-sm);
  line-height: 1.7;
  overflow-wrap: anywhere;
}

.state-trace {
  margin-top: 12rpx;
  color: var(--color-text-tertiary);
  font-size: var(--font-xs);
  overflow-wrap: anywhere;
}

.state-action {
  width: 100% !important;
  max-width: 520rpx;
  margin-top: 28rpx;
}

.state-action + .state-action {
  margin-top: 16rpx;
}

.state-compact .state-action {
  margin-top: 20rpx !important;
}

.state-compact .state-action + .state-action {
  margin-top: 12rpx !important;
}

.state-error .state-title {
  color: var(--color-danger);
}

.state-unavailable .state-title,
.state-permission .state-title {
  color: var(--color-warning);
}

.skeleton-group {
  width: 100%;
}

.skeleton {
  height: 22rpx;
  margin-top: 18rpx;
  border-radius: 12rpx;
  background: linear-gradient(90deg, var(--color-control) 25%, var(--color-bg) 50%, var(--color-control) 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.4s infinite linear;
}

.skeleton-long { width: 100%; }
.skeleton-short { width: 58%; }
.skeleton-medium { width: 78%; }

@keyframes skeleton-loading {
  from { background-position: 200% 0; }
  to { background-position: -200% 0; }
}


.state-icon { display: flex; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; border-radius: 22rpx; background: var(--color-primary-soft); }
.state-error .state-icon { background: var(--color-danger-soft); }
.state-permission .state-icon, .state-unavailable .state-icon { background: var(--color-warning-soft); }
@media (prefers-reduced-motion: reduce) {
  .skeleton { animation: none; }
}
