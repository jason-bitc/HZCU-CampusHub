.prototype-nav {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 80;
  display: flex;
  align-items: stretch;
  justify-content: space-around;
  padding: 12rpx 20rpx calc(12rpx + constant(safe-area-inset-bottom));
  padding: 12rpx 20rpx calc(12rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--color-border, #e3e8f0);
  background: var(--color-surface, #ffffff);
  box-shadow: 0 -4rpx 18rpx rgba(23, 32, 51, 0.04);
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  width: 25% !important;
  min-height: 92rpx;
  color: var(--color-text-secondary, #5d687a);
  font-size: var(--font-xs, 24rpx);
  line-height: 1.3;
}

.nav-active {
  color: var(--color-primary, #2563eb);
  font-weight: 650;
}

.nav-disabled {
  color: var(--color-text-secondary) !important;
  opacity: 1 !important;
  background: transparent !important;
}

.nav-status { font-size: 24rpx; }

.nav-icon { display: flex; align-items: center; justify-content: center; width: 58rpx; height: 48rpx; border-radius: 16rpx; }
.nav-item:not(.nav-active) .nav-icon { filter: grayscale(1); opacity: 0.74; }
.nav-active .nav-icon { background: var(--color-primary-soft); }
