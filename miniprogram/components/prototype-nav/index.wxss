.prototype-nav {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 80;
  display: flex;
  align-items: stretch;
  justify-content: space-around;
  padding: 0 0 constant(safe-area-inset-bottom);
  padding: 0 0 env(safe-area-inset-bottom);
  border-top: 1rpx solid var(--color-border, #cbdad2);
  background: var(--color-surface, #ffffff);
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  width: 25% !important;
  min-height: var(--tab-bar-height, 50px);
  color: var(--color-text-secondary, #53645e);
  font-size: var(--font-xs, 24rpx);
  line-height: 1.3;
}

.nav-active {
  color: var(--color-primary, #0d6b57);
  font-weight: 650;
}

.nav-disabled {
  color: var(--color-text-secondary) !important;
  opacity: 1 !important;
  background: transparent !important;
}

.nav-status { font-size: 24rpx; }

.nav-icon { display: flex; align-items: center; justify-content: center; height: 42rpx; }
.nav-item:not(.nav-active) .nav-icon { filter: grayscale(1); }
