.prototype-nav {
  display: flex;
  align-items: stretch;
  justify-content: space-around;
  padding: 12rpx 20rpx calc(12rpx + constant(safe-area-inset-bottom));
  padding: 12rpx 20rpx calc(12rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--color-border);
  background: var(--color-surface);
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  width: 25%;
  min-height: 92rpx;
  color: var(--color-text-tertiary);
  font-size: 22rpx;
  line-height: 1.3;
}

.nav-active {
  color: var(--color-primary);
  font-weight: 650;
}

.nav-disabled {
  opacity: 0.78;
}
