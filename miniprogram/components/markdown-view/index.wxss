.markdown-view {
  color: var(--color-text);
  font-size: 30rpx;
  line-height: 1.9;
}

.toc {
  margin-bottom: 36rpx;
  padding: 0 0 24rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.toc-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 64rpx;
  color: var(--color-primary);
  font-size: var(--font-sm);
  font-weight: 600;
}

.toc-toggle text:first-child {
  color: var(--color-text);
  font-size: var(--font-md);
}

.toc-list {
  padding-top: 10rpx;
}

.toc-item {
  display: block;
  width: 100%;
  padding: 10rpx 0;
  color: var(--color-primary);
  font-size: var(--font-sm);
  line-height: 1.55;
  text-align: left;
}

.toc-level-3 { padding-left: 24rpx; }
.toc-level-4 { padding-left: 48rpx; }

.md-block {
  margin-top: 28rpx;
  overflow-wrap: anywhere;
}

.md-block:first-child {
  margin-top: 0;
}

.md-heading {
  margin: 46rpx 0 20rpx;
  color: var(--color-text);
  font-weight: 700;
  line-height: 1.5;
}

.md-h1 { font-size: 40rpx; }
.md-h2 { font-size: 36rpx; }
.md-h3 { font-size: 32rpx; }
.md-h4 { font-size: 30rpx; }

.md-paragraph,
.md-quote,
.md-list {
  white-space: pre-wrap;
}

.inline-strong {
  font-weight: 700;
}

.inline-code {
  padding: 2rpx 7rpx;
  border-radius: 6rpx;
  background: #edf0ee;
  font-family: Consolas, Monaco, monospace;
  font-size: 26rpx;
}

.inline-link {
  color: var(--color-primary);
  text-decoration: underline;
  text-underline-offset: 5rpx;
}

.md-quote {
  margin: 30rpx 0;
  padding: 20rpx 24rpx;
  border-left: 6rpx solid var(--color-primary);
  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  background: var(--color-primary-soft);
  color: var(--color-primary-dark);
}

.md-list-item {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin: 12rpx 0;
}

.list-marker {
  flex: none;
  min-width: 30rpx;
  color: var(--color-primary);
  font-weight: 600;
  text-align: right;
}

.list-content {
  flex: 1;
  min-width: 0;
}

.md-code {
  width: 100%;
  margin: 30rpx 0;
  padding: 26rpx;
  border-radius: var(--radius-sm);
  background: #202723;
  color: #edf5f0;
  white-space: nowrap;
}

.md-code text {
  font-family: Consolas, Monaco, monospace;
  font-size: 25rpx;
  line-height: 1.8;
}

.md-image-block {
  margin: 34rpx 0;
}

.md-image {
  display: block;
  width: 100%;
  min-height: 120rpx;
  border-radius: var(--radius-md);
  background: #edf0ee;
}

.image-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 44rpx 24rpx;
  border: 1rpx dashed #c8ceca;
  border-radius: var(--radius-md);
  background: #f0f2f1;
  color: var(--color-text-secondary);
  font-size: var(--font-sm);
  text-align: center;
}

.image-error text {
  margin-top: 16rpx;
}

.image-retry {
  min-height: 68rpx;
  margin-top: 20rpx;
}

.image-caption {
  display: block;
  margin-top: 12rpx;
  color: var(--color-text-tertiary);
  font-size: var(--font-xs);
  line-height: 1.5;
  text-align: center;
}

.markdown-empty {
  padding: 48rpx 0;
  color: var(--color-text-tertiary);
  text-align: center;
}

.resource-card {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin: 34rpx 0;
  padding: 28rpx;
  border-radius: var(--radius-md);
  background: var(--color-primary-soft);
}

.resource-title {
  color: var(--color-primary-dark);
  font-size: 29rpx;
  font-weight: 700;
}

.resource-subtitle {
  color: var(--color-primary);
  font-size: 25rpx;
  line-height: 1.55;
}

.toc-float {
  position: fixed;
  right: 24rpx;
  bottom: calc(156rpx + constant(safe-area-inset-bottom));
  bottom: calc(156rpx + env(safe-area-inset-bottom));
  z-index: 90;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--color-primary);
  color: #ffffff;
  font-size: 21rpx;
  font-weight: 600;
  box-shadow: 0 10rpx 30rpx rgba(13, 107, 87, 0.22);
}

.toc-float:active,
.toc-float.pressable-hover {
  background: var(--color-primary-dark);
}

.toc-drawer-layer {
  position: fixed;
  z-index: 140;
  inset: 0;
}

.toc-drawer-mask {
  position: absolute;
  inset: 0;
  background: rgba(18, 28, 23, 0.42);
}

.toc-drawer {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  width: 72%;
  max-width: 560rpx;
  padding-top: constant(safe-area-inset-top);
  padding-top: env(safe-area-inset-top);
  background: var(--color-surface);
  box-shadow: -12rpx 0 36rpx rgba(18, 28, 23, 0.12);
}

.toc-drawer-header {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: space-between;
  min-height: 104rpx;
  padding: 0 28rpx;
  border-bottom: 1rpx solid var(--color-border);
  color: var(--color-text);
  font-size: 32rpx;
  font-weight: 700;
}

.toc-drawer-close {
  min-height: 56rpx;
  color: var(--color-primary);
  font-size: 25rpx;
}

.toc-drawer-body {
  flex: 1;
  min-height: 0;
  padding: 16rpx 28rpx calc(28rpx + constant(safe-area-inset-bottom));
  padding: 16rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
}

.toc-drawer-item {
  display: block;
  width: 100%;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--color-border);
  color: var(--color-text);
  font-size: 27rpx;
  line-height: 1.55;
  text-align: left;
  overflow-wrap: anywhere;
}

.toc-drawer-item:last-child {
  border-bottom: 0;
}
