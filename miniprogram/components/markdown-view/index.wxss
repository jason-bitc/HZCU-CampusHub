.markdown-view {
  color: var(--color-text);
  padding-top: 32rpx;
  font-size: 32rpx;
  line-height: 1.75;
}


.md-block {
  margin-top: 28rpx;
  overflow-wrap: anywhere;
}

.md-block:first-child {
  margin-top: 0;
}

.md-block:first-child .md-heading { margin-top: 0; }

.md-heading {
  margin: 46rpx 0 20rpx;
  color: var(--color-text);
  font-weight: 700;
  line-height: 1.5;
}

.md-h1 { font-size: 40rpx; }
.md-h2 { font-size: 36rpx; }
.md-h3 { font-size: 32rpx; }
.md-h4 { font-size: 30rpx; }
.md-h5, .md-h6 { font-size: 30rpx; }

.md-paragraph,
.md-quote,
.md-list {
  white-space: pre-wrap;
}

.inline-strong {
  font-weight: 700;
}

.inline-code {
  padding: 2rpx 7rpx;
  border-radius: 6rpx;
  background: #edf0ee;
  font-family: Consolas, Monaco, monospace;
  font-size: 26rpx;
}

.inline-link {
  color: var(--color-primary);
  text-decoration: underline;
  text-underline-offset: 5rpx;
}

.md-quote {
  margin: 30rpx 0;
  padding: 20rpx 24rpx;
  border-left: 6rpx solid var(--color-primary);
  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  background: var(--color-primary-soft);
  color: var(--color-primary-dark);
}

.md-list-item {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin: 12rpx 0;
}

.list-marker {
  flex: none;
  min-width: 30rpx;
  color: var(--color-primary);
  font-weight: 600;
  text-align: right;
}

.list-content {
  flex: 1;
  min-width: 0;
}

.md-code {
  width: 100%;
  margin: 30rpx 0;
  padding: 26rpx;
  border-radius: var(--radius-sm);
  background: #202723;
  color: #edf5f0;
  white-space: nowrap;
}

.md-code-text {
  display: inline-block;
  min-width: 100%;
  white-space: pre;
  font-family: Consolas, Monaco, monospace;
  font-size: 26rpx;
  line-height: 1.8;
}

.md-image-block {
  margin: 34rpx 0;
}

.md-image {
  display: block;
  width: 100%;
  min-height: 120rpx;
  border-radius: var(--radius-md);
  background: #edf0ee;
}

.image-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 44rpx 24rpx;
  border: 1rpx dashed #c8ceca;
  border-radius: var(--radius-md);
  background: #f0f2f1;
  color: var(--color-text-secondary);
  font-size: var(--font-sm);
  text-align: center;
}

.image-error-message {
  margin-top: 16rpx;
}

.image-retry {
  min-height: var(--touch-target);
  margin-top: 20rpx;
}

.image-caption {
  display: block;
  margin-top: 12rpx;
  color: var(--color-text-tertiary);
  font-size: var(--font-xs);
  line-height: 1.5;
  text-align: center;
}

.markdown-empty {
  padding: 48rpx 0;
  color: var(--color-text-tertiary);
  text-align: center;
}

.resource-card {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin: 34rpx 0;
  padding: 28rpx;
  border-radius: var(--radius-md);
  background: var(--color-primary-soft);
  width: 100% !important;
  text-align: left;
}

.resource-title {
  color: var(--color-primary-dark);
  font-size: 29rpx;
  font-weight: 700;
}

.resource-subtitle {
  color: var(--color-primary);
  font-size: 25rpx;
  line-height: 1.55;
}

.toc-float {
  position: fixed;
  right: 24rpx;
  z-index: 90;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  width: 44px !important;
  height: 44px;
  min-width: 44px;
  min-height: 44px;
  padding: 4rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 12rpx;
  background: var(--color-surface);
  color: var(--color-primary-dark);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.15;
}

.toc-float:active,
.toc-float.pressable-hover {
  background: var(--color-primary-soft);
}

.toc-drawer-layer {
  position: fixed;
  z-index: 140;
  inset: 0;
}

.toc-drawer-mask {
  position: absolute;
  inset: 0;
  background: rgba(18, 28, 23, 0.42);
}

.toc-drawer {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  width: 72%;
  max-width: 560rpx;
  padding-top: 0;
  background: var(--color-surface);
  box-shadow: -12rpx 0 36rpx rgba(18, 28, 23, 0.12);
}

.toc-drawer-header {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: space-between;
  min-height: 104rpx;
  padding: 0 28rpx;
  border-bottom: 1rpx solid var(--color-border);
  color: var(--color-text);
  font-size: 32rpx;
  font-weight: 700;
}

.toc-drawer-close {
  min-width: var(--touch-target);
  min-height: var(--touch-target);
  color: var(--color-primary);
  font-size: 25rpx;
}

.toc-drawer-body {
  flex: 1;
  min-height: 0;
  padding: 16rpx 28rpx calc(28rpx + constant(safe-area-inset-bottom));
  padding: 16rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
}

.toc-drawer-item {
  display: block;
  width: 100% !important;
  min-height: var(--touch-target);
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--color-border);
  color: var(--color-text);
  font-size: 27rpx;
  line-height: 1.55;
  text-align: left;
  overflow-wrap: anywhere;
}

.toc-drawer-item:last-child {
  border-bottom: 0;
}

.toc-search { margin: 16rpx 24rpx; padding: 0 20rpx; border: 1rpx solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-bg); }
.toc-search-input { height: var(--touch-target); font-size: var(--font-sm); }
.toc-current { color: var(--color-primary-dark); background: var(--color-primary-soft); font-weight: 700; }
.toc-no-match { display: block; padding: 24rpx 0; color: var(--color-text-secondary); font-size: var(--font-sm); }
