<template name="inline-segments">
  <block wx:for="{{segments}}" wx:for-item="segment" wx:key="key">
    <text wx:if="{{segment.type !== 'link'}}" class="inline-{{segment.type}}" user-select>{{segment.text}}</text>
    <text wx:else class="inline-link" role="link" aria-label="复制链接：{{segment.text}}" data-url="{{segment.url}}" bindtap="copyLink">{{segment.text}}</text>
  </block>
</template>
<view class="markdown-view">
  <view wx:if="{{!nodes.length}}" class="markdown-empty">正文暂无内容</view>
  <view wx:for="{{nodes}}" wx:key="id" id="md-block-{{item.id}}" class="md-block">
    <view wx:if="{{item.type === 'heading'}}" class="md-heading md-h{{item.level}}">{{item.text}}</view>
    <view wx:elif="{{item.type === 'paragraph'}}" class="md-paragraph"><template is="inline-segments" data="{{segments: item.segments}}" /></view>
    <view wx:elif="{{item.type === 'quote'}}" class="md-quote"><template is="inline-segments" data="{{segments: item.segments}}" /></view>
    <view wx:elif="{{item.type === 'list'}}" class="md-list">
      <view wx:for="{{item.items}}" wx:for-item="listItem" wx:key="id" class="md-list-item" style="margin-left: {{listItem.indent}}rpx;">
        <text class="list-marker">{{listItem.marker}}</text>
        <view class="list-content"><template is="inline-segments" data="{{segments: listItem.segments}}" /></view>
      </view>
    </view>
    <scroll-view wx:elif="{{item.type === 'code'}}" scroll-x class="md-code" enhanced show-scrollbar="{{true}}"><text class="md-code-text" user-select>{{item.text}}</text></scroll-view>
    <view wx:elif="{{item.type === 'image'}}" class="md-image-block">
      <image wx:if="{{!item.failed}}" class="md-image" src="{{item.src}}" mode="widthFix" lazy-load show-menu-by-longpress data-index="{{index}}" bindload="handleImageLoad" binderror="handleImageError" bindtap="previewImage" aria-label="{{item.alt}}" />
      <view wx:else class="image-error">
        <app-icon name="image" size="48" /><text class="image-error-message">图片加载失败：{{item.alt}}</text>
        <button wx:if="{{item.originalSrc}}" class="button-secondary image-retry" data-index="{{index}}" bindtap="retryImage">重试图片</button>
      </view>
      <text class="image-caption">{{item.alt}}{{item.failed ? '' : ' · 点击查看大图'}}</text>
    </view>
    <button wx:elif="{{item.type === 'resource'}}" class="resource-card pressable" bindtap="goToSources">
      <text class="resource-title">资料：{{firstSourceLink.label}}</text><text class="resource-subtitle">查看 {{sourceLinks.length}} 个资料链接与来源说明</text>
    </button>
  </view>
  <button wx:if="{{headings.length}}" class="toc-float pressable" style="top: {{demoMode ? 76 : 16}}rpx;" bindtap="openToc" aria-label="打开文章目录"><app-icon name="list" size="26" /><text>目录</text></button>
  <view wx:if="{{tocDrawerVisible}}" class="toc-drawer-layer">
    <view class="toc-drawer-mask" bindtap="closeToc" catchtouchmove="stopTouchMove" aria-label="关闭文章目录"></view>
    <view class="toc-drawer" role="dialog" aria-modal="true" aria-label="文章目录">
      <view class="toc-drawer-header"><text>文章目录</text><button class="toc-drawer-close pressable" bindtap="closeToc">关闭</button></view>
      <view class="toc-search"><input class="toc-search-input" value="{{tocSearch}}" maxlength="100" placeholder="查找章节" placeholder-class="input-placeholder" aria-label="查找文章章节" bindinput="searchToc" /></view>
      <scroll-view scroll-y class="toc-drawer-body" enhanced show-scrollbar="{{true}}" scroll-into-view="toc-heading-{{currentHeadingId}}">
        <button wx:for="{{filteredHeadings}}" wx:key="id" id="toc-heading-{{item.id}}" class="toc-drawer-item {{currentHeadingId === item.id ? 'toc-current' : ''}}" style="padding-left: {{item.indent}}rpx;" data-id="{{item.id}}" bindtap="scrollToHeading">{{item.text}}</button>
        <text wx:if="{{!filteredHeadings.length}}" class="toc-no-match">没有匹配章节，请修改关键词。</text>
      </scroll-view>
    </view>
  </view>
</view>
