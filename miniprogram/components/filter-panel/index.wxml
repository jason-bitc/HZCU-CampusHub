<view wx:if="{{visible}}" class="filter-layer">
  <view class="filter-mask" bindtap="close" catchtouchmove="stopTouchMove"></view>
  <view class="filter-page" role="dialog" aria-modal="true" aria-label="组合筛选">
  <view class="filter-grip" aria-hidden="true"></view>
  <view class="filter-navbar">
    <text class="nav-title">组合筛选</text>
    <button class="filter-cancel pressable" bindtap="close">关闭</button>
  </view>

  <scroll-view scroll-y class="filter-body" enhanced show-scrollbar="{{false}}">
    <view class="filter-card">
      <view wx:if="{{draft.keyword}}" class="search-note">当前搜索：{{draft.keyword}}（返回发现页修改）</view>
      <view wx:if="{{catalogLoading}}" class="catalog-status">正在加载筛选选项…</view>
      <view wx:elif="{{catalogError}}" class="catalog-status">
        <text>筛选选项加载失败，已保留当前条件。</text>
        <button class="button-secondary catalog-retry" bindtap="retry">重试加载选项</button>
      </view>
      <view wx:if="{{selectedChips.length}}" class="selected-section">
        <text class="section-label">待应用</text>
        <view class="selected-list">
          <button wx:for="{{selectedChips}}" wx:key="key" class="selected-chip pressable" data-key="{{item.key}}" bindtap="clearSelected" aria-label="移除{{item.label}}">{{item.label}} ×</button>
        </view>
      </view>

      <view class="job-section">
        <text class="section-label">目标岗位</text>
        <view class="topic-list">
          <button class="topic-chip {{!draft.jobId ? 'topic-active' : ''}}" data-value="0" bindtap="selectJob">全部</button>
          <button wx:for="{{catalog.jobs}}" wx:key="id" class="topic-chip {{draft.jobId === item.id ? 'topic-active' : ''}}" data-value="{{item.id}}" bindtap="selectJob" aria-pressed="{{draft.jobId === item.id}}">{{item.name}}</button>
        </view>
      </view>

      <view class="major-section">
        <text class="section-label">文章适用专业</text>
        <view class="topic-list">
          <button class="topic-chip {{!draft.majorId ? 'topic-active' : ''}}" data-value="0" bindtap="selectMajor" aria-pressed="{{!draft.majorId}}">全部专业</button>
          <button wx:for="{{catalog.majors}}" wx:key="id" class="topic-chip {{draft.majorId === item.id ? 'topic-active' : ''}}" data-value="{{item.id}}" bindtap="selectMajor" aria-pressed="{{draft.majorId === item.id}}">{{item.name}}</button>
        </view>
      </view>

      <view class="same-major-note"><button class="button-text same-major-button" bindtap="sameMajor">{{signedIn ? ownMajorId ? '按本人专业筛选' : '填写本人专业，启用同专业' : '登录后使用同专业'}}</button><text wx:if="{{profileError}}">{{profileError}}</text></view>

      <view class="company-section">
        <button class="filter-option" data-option="company" bindtap="toggleOption" aria-expanded="{{expandedOption === 'company'}}"><text>公司</text><text class="option-value">{{companyError ? '请修正公司条件' : draft.companyId ? companyInput : '不限'}}</text><app-icon name="chevron-right" size="24" /></button>
        <view wx:if="{{expandedOption === 'company'}}" class="optional-fields">
        <view class="company-input-row">
          <input class="company-input" value="{{companyInput}}" maxlength="100" placeholder="输入公司名，或保持不限" placeholder-class="input-placeholder" aria-label="公司名称" bindinput="handleCompanyInput" />
          <button wx:if="{{companyInput}}" class="company-clear pressable" bindtap="clearCompany" aria-label="清空公司">
            <app-icon name="close" size="28" />
          </button>
        </view>
        <view wx:if="{{companySuggestions.length}}" class="company-suggestions">
          <button wx:for="{{companySuggestions}}" wx:key="id" class="company-suggestion pressable" data-id="{{item.id}}" bindtap="selectCompanySuggestion">匹配：{{item.name}}</button>
        </view>
        <text wx:if="{{companyError}}" class="field-error">{{companyError}}</text>
        <text class="company-contract-note">仅支持选择已有公司标签；公司不限时，也会展示未标注公司的经验。</text>
        </view>
      </view>

      <view class="topic-section">
        <button class="filter-option" data-option="topic" bindtap="toggleOption" aria-expanded="{{expandedOption === 'topic'}}"><text>主题</text><text class="option-value">{{topicName || '不限'}}</text><app-icon name="chevron-right" size="24" /></button>
        <view wx:if="{{expandedOption === 'topic'}}" class="topic-list optional-fields">
          <button class="topic-chip {{!draft.topicId ? 'topic-active' : ''}}" data-value="0" bindtap="selectTopic">全部</button>
          <button wx:for="{{catalog.topics}}" wx:key="id" class="topic-chip {{draft.topicId === item.id ? 'topic-active' : ''}}" data-value="{{item.id}}" bindtap="selectTopic">{{item.name}}</button>
        </view>
      </view>
    </view>
  </scroll-view>

  <view class="filter-footer">
    <button class="button-secondary reset-button" bindtap="reset">重置条件</button>
    <button class="button-primary apply-button" bindtap="apply" disabled="{{catalogLoading || catalogError || companyError}}">查看匹配经验</button>
  </view>
  </view>
</view>
