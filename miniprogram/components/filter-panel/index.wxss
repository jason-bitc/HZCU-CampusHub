.filter-page {
  position: fixed;
  z-index: 100;
  inset: 0;
  display: flex;
  flex-direction: column;
  background: var(--color-bg);
}

.filter-navbar {
  display: flex;
  flex: none;
  align-items: center;
  height: 104rpx;
  padding: 0 20rpx;
  background: var(--color-bg);
}

.nav-back,
.nav-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
}

.nav-title {
  flex: 1;
  color: var(--color-text);
  font-size: 34rpx;
  font-weight: 650;
  text-align: center;
}

.filter-body {
  flex: 1;
  min-height: 0;
  padding: 12rpx 24rpx 24rpx;
}

.filter-card {
  padding: 30rpx 28rpx 34rpx;
  border-radius: var(--radius-md);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.selected-section {
  margin-bottom: 28rpx;
}

.section-label {
  display: block;
  margin-bottom: 18rpx;
  color: var(--color-text);
  font-size: 30rpx;
  font-weight: 700;
}

.selected-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.selected-chip {
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-size: 24rpx;
  line-height: 1.5;
}

.major-section {
  margin-top: 8rpx;
}

.major-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 100rpx;
  border-bottom: 1rpx solid var(--color-border);
  text-align: left;
}

.major-name {
  color: var(--color-text);
  font-size: 29rpx;
  font-weight: 600;
}

.major-active {
  color: var(--color-primary-dark);
}

.row-status {
  color: var(--color-text-secondary);
  font-size: 25rpx;
}

.status-active {
  color: var(--color-primary);
}

.same-major-note {
  margin: 28rpx 0 30rpx;
  padding: 24rpx;
  border-radius: var(--radius-sm);
  background: var(--color-primary-soft);
  color: var(--color-primary-dark);
  font-size: 25rpx;
  line-height: 1.7;
}

.company-section,
.topic-section {
  margin-top: 30rpx;
}

.company-input-row {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 0 20rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  background: var(--color-bg);
}

.company-input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  font-size: 27rpx;
}

.company-clear {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 60rpx;
}

.company-suggestions {
  display: flex;
  flex-direction: column;
  margin-top: 12rpx;
  overflow: hidden;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-sm);
}

.company-suggestion {
  padding: 20rpx;
  background: var(--color-surface);
  color: var(--color-primary);
  font-size: 25rpx;
  text-align: left;
}

.company-suggestion + .company-suggestion {
  border-top: 1rpx solid var(--color-border);
}

.field-error {
  display: block;
  margin-top: 12rpx;
  color: var(--color-danger);
  font-size: 23rpx;
  line-height: 1.5;
}

.company-contract-note {
  display: block;
  margin-top: 12rpx;
  color: var(--color-text-tertiary);
  font-size: 22rpx;
  line-height: 1.5;
}

.topic-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.topic-chip {
  padding: 11rpx 18rpx;
  border-radius: 8rpx;
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-size: 25rpx;
  line-height: 1.5;
}

.topic-active {
  background: var(--color-primary);
  color: #ffffff;
  font-weight: 600;
}

.filter-footer {
  display: flex;
  flex: none;
  gap: 20rpx;
  padding: 18rpx 24rpx calc(18rpx + constant(safe-area-inset-bottom));
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--color-border);
  background: var(--color-bg);
}

.reset-button { width: 34%; }
.apply-button { flex: 1; }
