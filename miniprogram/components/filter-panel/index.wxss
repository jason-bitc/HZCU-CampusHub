.filter-layer {
  position: fixed;
  z-index: 140;
  inset: 0;
}

.filter-mask {
  position: absolute;
  inset: 0;
  background: rgba(18, 28, 23, 0.42);
}

.filter-page {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  height: 76%;
  overflow: hidden;
  border-radius: var(--radius-md) var(--radius-md) 0 0;
  background: var(--color-surface);
}

.filter-navbar {
  display: flex;
  flex: none;
  align-items: center;
  min-height: var(--touch-target);
  padding: 14rpx var(--page-gutter);
  border-bottom: 1rpx solid var(--color-border);
}

.filter-grip {
  flex: none;
  width: 68rpx;
  height: 7rpx;
  margin: 12rpx auto 0;
  border-radius: 10rpx;
  background: var(--color-border);
}

.nav-title {
  flex: 1;
  color: var(--color-text);
  font-size: 34rpx;
  font-weight: 650;
}

.filter-body {
  flex: 1;
  height: 0;
  min-height: 0;
  box-sizing: border-box;
}

.filter-card {
  padding: 26rpx var(--page-gutter);
}

.selected-section {
  display: flex;
  align-items: baseline;
  gap: 18rpx;
  margin-bottom: 28rpx;
}
.selected-section .section-label { flex: none; margin: 0; color: var(--color-text-secondary); font-size: var(--font-xs); font-weight: 400; }

.section-label {
  display: block;
  margin-bottom: 18rpx;
  color: var(--color-text);
  font-size: 30rpx;
  font-weight: 700;
}

.selected-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.selected-chip {
  display: flex;
  align-items: center;
  min-height: var(--touch-target);
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-size: var(--font-xs);
  line-height: 1.5;
}

.major-section {
  padding-top: 22rpx;
  border-top: 1rpx solid var(--color-border);
}

.same-major-note {
  margin: 4rpx 0;
  color: var(--color-text-secondary);
  font-size: 25rpx;
  line-height: 1.7;
}
.same-major-button { padding: 0; font-weight: 500; font-size: var(--font-xs); }

.company-section { border-top: 1rpx solid var(--color-border); }
.filter-option { display: flex; align-items: center; gap: 12rpx; width: 100% !important; min-height: var(--touch-target); text-align: left; }
.option-value { flex: 1; min-width: 0; color: var(--color-text-secondary); font-size: var(--font-sm); white-space: normal; overflow-wrap: anywhere; text-align: right; }
.optional-fields { margin: 0 0 18rpx; }

.company-input-row {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 0 20rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  background: var(--color-bg);
}

.company-input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  font-size: 27rpx;
}

.company-clear {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: var(--touch-target) !important;
  height: var(--touch-target);
}

.company-suggestions {
  display: flex;
  flex-direction: column;
  margin-top: 12rpx;
  overflow: hidden;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-sm);
}

.company-suggestion {
  padding: 20rpx;
  background: var(--color-surface);
  color: var(--color-primary);
  font-size: 25rpx;
  text-align: left;
}

.company-suggestion + .company-suggestion {
  border-top: 1rpx solid var(--color-border);
}

.field-error {
  display: block;
  margin-top: 12rpx;
  color: var(--color-danger);
  font-size: var(--font-xs);
  line-height: 1.5;
}

.company-contract-note {
  display: block;
  margin-top: 12rpx;
  color: var(--color-text-tertiary);
  font-size: var(--font-xs);
  line-height: 1.5;
}

.topic-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.topic-chip {
  display: flex;
  align-items: center;
  min-height: var(--touch-target);
  padding: 11rpx 18rpx;
  border: 1rpx solid transparent;
  border-radius: 999rpx;
  background: var(--color-control);
  color: var(--color-text);
  font-size: 25rpx;
  line-height: 1.5;
}

.topic-active {
  border-color: var(--color-primary);
  background: var(--color-selected);
  color: var(--color-primary-dark);
  font-weight: 600;
}

.filter-footer {
  display: flex;
  flex: none;
  gap: 20rpx;
  padding: 18rpx 24rpx calc(18rpx + constant(safe-area-inset-bottom));
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--color-border);
  background: var(--color-surface);
}

.reset-button { width: 34%; }
.apply-button { flex: 1; }

.filter-cancel { min-width: var(--touch-target); min-height: var(--touch-target); color: var(--color-primary); font-size: var(--font-sm); }
.search-note { margin-bottom: 24rpx; font-size: var(--font-xs); line-height: 1.7; }
.search-note { color: var(--color-primary-dark); overflow-wrap: anywhere; }
.job-section { margin-bottom: 28rpx; }
.catalog-status { margin: 24rpx 0; color: var(--color-danger); font-size: var(--font-sm); }
.catalog-retry { margin-top: 16rpx; }
