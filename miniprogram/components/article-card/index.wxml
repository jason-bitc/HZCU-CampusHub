<view class="article-card {{feed ? 'feed-card' : ''}} pressable" hover-class="pressable-hover" bindtap="handleTap" role="button" aria-label="阅读 {{article.title}}">
  <text class="article-title">{{article.title}}</text>
  <text wx:if="{{!feed}}" class="article-summary">{{article.summary}}</text>
  <view class="tag-row">
    <text class="tag">{{article.jobText}}</text>
    <text class="tag">{{article.majorText}}</text>
    <text class="tag {{feed ? 'tag-muted' : ''}}">{{article.experienceStage}}</text>
    <text wx:if="{{article.companyText}}" class="tag tag-muted">{{article.companyText}}</text>
  </view>
  <text wx:if="{{feed && article.summary}}" class="article-summary">{{article.summary}}</text>
  <view wx:if="{{feed}}" class="feed-footer">
    <view class="feed-details">
      <view class="feed-meta">
        <text class="feed-source">{{article.sourceText}}</text>
        <text wx:if="{{article.publishedText}}">{{article.publishedText}}</text>
        <text>投币 {{article.effectiveCoins}}</text>
      </view>
      <text class="feed-author">作者资料认证后可见</text>
    </view>
    <text class="feed-read" aria-hidden="true">阅读</text>
  </view>
  <view wx:else class="article-meta">
    <text class="meta-text">{{article.sourceText}} · 作者信息认证后可见</text>
    <text class="coin-text">投币 {{article.effectiveCoins}}</text>
  </view>
</view>
