<view class="article-card pressable" hover-class="pressable-hover" bindtap="handleTap" role="button" aria-label="阅读 {{article.title}}">
  <text class="article-title">{{article.title}}</text>
  <text class="article-summary">{{article.summary}}</text>
  <view class="tag-row">
    <text class="tag tag-primary">{{article.jobText}}</text>
    <text class="tag">{{article.majorText}}</text>
    <text wx:if="{{article.companyText}}" class="tag tag-muted">{{article.companyText}}</text>
  </view>
  <view wx:if="{{article.topicText}}" class="topic-line">主题 · {{article.topicText}}</view>
  <view class="article-meta">
    <text class="meta-text">{{article.experienceStage}} · {{article.sourceText}}</text>
    <text class="recognition">{{article.effectiveLikes}} 人认可</text>
  </view>
</view>
