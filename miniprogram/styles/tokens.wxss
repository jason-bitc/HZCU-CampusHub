page {
  --color-primary: #0d6b57;
  --color-primary-dark: #075342;
  --color-primary-soft: #e6f2ed;
  --color-bg: #f5f7f6;
  --color-surface: #ffffff;
  --color-text: #202723;
  --color-text-secondary: #58645d;
  --color-text-tertiary: #626e67;
  --color-border: #e3e8e5;
  --color-danger: #a94c50;
  --color-danger-soft: #f9eded;
  --color-warning: #85691f;
  --color-warning-soft: #faf5e7;
  --font-xs: 24rpx;
  --font-sm: 28rpx;
  --font-md: 32rpx;
  --font-lg: 34rpx;
  --font-xl: 38rpx;
  --space-1: 8rpx;
  --space-2: 16rpx;
  --space-3: 24rpx;
  --space-4: 32rpx;
  --space-5: 40rpx;
  --space-6: 48rpx;
  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-lg: 28rpx;
  --shadow-card: none;
  --touch-target: max(88rpx, 44px);
}
