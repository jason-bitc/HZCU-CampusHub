page {
  --color-primary: #0d6b57;
  --color-primary-dark: #075343;
  --color-primary-soft: #e7f1ec;
  --color-selected: #d9ede4;
  --color-control: #edf0ee;
  --color-bg: #f1f5f3;
  --color-surface: #ffffff;
  --color-text: #202b27;
  --color-text-secondary: #53645e;
  --color-text-tertiary: #586a63;
  --color-border: #cbdad2;
  --color-success: #196849;
  --color-success-soft: #e8f6ee;
  --color-violet: #5b42a9;
  --color-violet-soft: #f0ebfc;
  --motion-fast: 180ms;
  --color-danger: #a03443;
  --color-danger-soft: #fff0f1;
  --color-warning: #825017;
  --color-warning-soft: #fff4e5;
  --font-xs: 24rpx;
  --font-sm: 28rpx;
  --font-md: 32rpx;
  --font-lg: 34rpx;
  --font-xl: 38rpx;
  --space-1: 8rpx;
  --space-2: 16rpx;
  --space-3: 24rpx;
  --space-4: 32rpx;
  --space-5: 40rpx;
  --space-6: 48rpx;
  --radius-sm: 16rpx;
  --radius-md: 24rpx;
  --radius-lg: 28rpx;
  --shadow-card: 0 2rpx 8rpx rgba(26, 58, 45, 0.04);
  --page-gutter: 32rpx;
  --tab-bar-height: max(100rpx, 50px);
  --touch-target: max(88rpx, 44px);
}
