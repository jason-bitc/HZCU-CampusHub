{
  "info": {
    "name": "CampusHub 首批后端：游客文章读取",
    "description": "本地演示数据；不含凭据。数据库故障与重启验证由MySQL集成测试执行。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
