    {
      "name": "第二阶段身份流程（仅本人，逐步输入验证码）",
      "item": [
        {
          "name": "申请本人注册码",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/registration-codes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 202\", () => pm.response.to.have.status(202));",
                  "const body = pm.response.json();",
                  "pm.test(\"追踪一致\", () => pm.expect(pm.response.headers.get(\"X-Trace-Id\")).to.equal(body.traceId));",
                  "pm.test(\"身份响应禁止缓存\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.equal(\"no-store\"));",
                  "if (pm.response.code === 202) pm.variables.set(\"registrationChallengeId\", body.data.challengeId); // transient local/run scope only"
                ]
              }
            }
          ]
        },
        {
