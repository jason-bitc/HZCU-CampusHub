    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8080",
      "type": "string"
    },
    {
      "key": "email",
      "value": "",
      "type": "string"
    },
    {
      "key": "password",
      "value": "",
      "type": "string"
    },
    {
      "key": "receivedCode",
      "value": "",
      "type": "string"
    },
    {
      "key": "registrationChallengeId",
      "value": "",
      "type": "string"
    },
    {
      "key": "resetChallengeId",
      "value": "",
      "type": "string"
    },
    {
      "key": "accessToken",
