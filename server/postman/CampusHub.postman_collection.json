      "type": "string"
    }
  ],
  "item": [
    {
      "name": "健康检查",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/actuator/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('追踪编号一致', () => { pm.expect(body.traceId).to.match(/^[0-9a-f-]{36}$/); pm.expect(pm.response.headers.get('X-Trace-Id')).to.equal(body.traceId); });",
              "pm.test('成功格式', () => { pm.expect(body.code).to.equal('OK'); pm.expect(body).to.have.property('data'); pm.expect(body).not.to.have.property('message'); });"
            ]
          }
        }
      ]
    },
