# Set environment variables, or create Git-ignored server/.env.local.json.
# Never put real passwords here.
CAMPUSHUB_DB_HOST=127.0.0.1
CAMPUSHUB_DB_PORT=3306
CAMPUSHUB_DB_NAME=campushub_dev
CAMPUSHUB_DB_USERNAME=YOUR_AUTHORIZED_USER
CAMPUSHUB_DB_PASSWORD=SET_LOCALLY
CAMPUSHUB_TEST_DB_USERNAME=YOUR_AUTHORIZED_TEST_USER
CAMPUSHUB_TEST_DB_PASSWORD=SET_LOCALLY

# SMTP settings; do not put the real client authorization password here.
CAMPUSHUB_MAIL_HOST=smtp.qiye.163.com
CAMPUSHUB_MAIL_PORT=465
CAMPUSHUB_MAIL_FROM=YOUR_AUTHORIZED_SENDER
CAMPUSHUB_MAIL_USERNAME=YOUR_AUTHORIZED_SENDER
CAMPUSHUB_MAIL_TLS_MODE=SSL
CAMPUSHUB_MAIL_TIMEOUT_MS=10000
# Scripts read the actual SMTP secret from Git-ignored .env.smtp.txt.
# Generate a persistent local authentication key using Initialize-AuthKey.ps1.
